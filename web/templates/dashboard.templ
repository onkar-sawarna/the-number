package templates

templ GuidancePage(p Page) {
	@Layout(p) {
		<h1 class="font-serif text-4xl tracking-tight">Category-level guidance</h1>
		<p class="mt-2 max-w-2xl text-ink/65 dark:text-zinc-400">A sleeve mix across index categories. Never a stock, fund, AMC, or ticker.</p>
		<form class="mt-8 grid gap-8 lg:grid-cols-12" hx-post="/guidance" hx-target="#guidance-result" hx-swap="innerHTML" hx-indicator="#guide-ind">
			<div class="space-y-5 lg:col-span-5">
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60">Age</span>
					<input type="number" name="age" value="30" min="18" max="90" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2 dark:border-white/10 dark:bg-white/5"/>
				</label>
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60">Horizon (years)</span>
					<input type="number" name="horizon" value="10" min="1" max="50" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2 dark:border-white/10 dark:bg-white/5"/>
				</label>
				<fieldset class="text-sm">
					<legend class="mb-2 text-ink/60">Risk stance</legend>
					<label class="mr-4"><input type="radio" name="risk" value="conservative" class="mr-1"/> Conservative</label>
					<label class="mr-4"><input type="radio" name="risk" value="moderate" checked class="mr-1"/> Moderate</label>
					<label><input type="radio" name="risk" value="aggressive" class="mr-1"/> Aggressive</label>
				</fieldset>
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60">Monthly investable (₹)</span>
					<input type="number" name="monthly_investable" value="25000" min="0" step="500" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2 dark:border-white/10 dark:bg-white/5"/>
				</label>
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60">Goals</span>
					<textarea name="goals" rows="4" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2 dark:border-white/10 dark:bg-white/5" placeholder="Independence, a home, children’s education — in your words."></textarea>
				</label>
				<button type="submit" class="rounded-full bg-brand px-5 py-2.5 text-sm font-medium text-white">Show mix</button>
				<span id="guide-ind" class="htmx-indicator ml-2 text-sm text-ink/60">Working…</span>
			</div>
			<div class="lg:col-span-7">
				<div id="guidance-result" class="rounded-2xl border border-dashed border-black/10 p-6 text-sm text-ink/50 dark:border-white/15">
					Submit the form to see a category mix and donut. Sliders elsewhere stay on-device; this post is the one network call.
				</div>
			</div>
		</form>
	}
}

templ GuidanceResult(v GuidanceResultView) {
	<div class="rounded-2xl border border-black/5 bg-white/80 p-6 shadow-card dark:border-white/10 dark:bg-white/5" data-donut-labels={ v.Labels } data-donut-values={ v.Values }>
		if v.Warning != "" {
			<p class="mb-4 rounded-xl bg-amber-50 px-3 py-2 text-sm text-amber-950 dark:bg-amber-950/40 dark:text-amber-100">{ v.Warning }</p>
		}
		<div class="flex items-center justify-between gap-3">
			<h2 class="font-serif text-2xl">Suggested sleeves</h2>
			<span class="rounded-full bg-black/5 px-3 py-1 text-xs dark:bg-white/10">{ v.Source }</span>
		</div>
		<div class="mx-auto mt-4 max-w-xs">
			<canvas id="guidance-donut"></canvas>
		</div>
		<ul class="mt-6 space-y-2 text-sm">
			for _, s := range v.Sleeves {
				<li class="flex justify-between border-b border-black/5 py-2 dark:border-white/10">
					<span>{ s.Category }</span>
					<span class="font-serif tabular-nums">{ s.Percent }%</span>
				</li>
			}
		</ul>
		<p class="mt-6 text-sm leading-relaxed text-ink/70 dark:text-zinc-300">{ v.Rationale }</p>
	</div>
}

templ DashboardPage(p Page) {
	@Layout(p) {
		<div x-data="dashList()">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div>
					<h1 class="font-serif text-4xl tracking-tight">Dashboard</h1>
					<p class="mt-2 text-ink/65 dark:text-zinc-400">Saved scenarios. Tick exactly two to compare.</p>
				</div>
				<a x-bind:href="compareHref()" x-bind:class="compareClass()" class="rounded-full bg-brand px-5 py-2.5 text-sm font-medium text-white">Compare</a>
			</div>
			<div
				id="scenario-list"
				class="mt-8"
				hx-get="/dashboard/list"
				hx-trigger="load"
				hx-indicator="#list-ind"
				x-on:htmx:after-swap="reset()"
			>
				<p id="list-ind" class="htmx-indicator text-sm text-ink/60">Loading…</p>
			</div>
		</div>
	}
}

templ ScenarioList(rows []ScenarioVM) {
	if len(rows) == 0 {
		<div class="rounded-2xl border border-dashed border-black/10 px-6 py-12 text-center dark:border-white/15">
			<p class="text-ink/70">No saved scenarios yet.</p>
			<a href="/calculators/fire" class="mt-3 inline-block text-brand underline underline-offset-2">Open the FIRE calculator</a>
		</div>
	} else {
		<div class="overflow-x-auto rounded-2xl border border-black/5 bg-white/80 dark:border-white/10 dark:bg-white/5">
			<table class="w-full min-w-[36rem] text-left text-sm">
				<thead class="border-b border-black/5 text-ink/50 dark:border-white/10">
					<tr>
						<th class="px-4 py-3 font-medium"></th>
						<th class="px-4 py-3 font-medium">Date</th>
						<th class="px-4 py-3 font-medium">Kind</th>
						<th class="px-4 py-3 font-medium">Title</th>
						<th class="px-4 py-3 font-medium"></th>
					</tr>
				</thead>
				<tbody>
					for _, r := range rows {
						<tr class="border-b border-black/5 last:border-0 dark:border-white/10">
							<td class="px-4 py-3">
								<input type="checkbox" data-id={ uintStr(r.ID) } x-on:change="toggle($el.dataset.id, $event)" class="accent-brand"/>
							</td>
							<td class="px-4 py-3 tabular-nums text-ink/70">{ r.Date }</td>
							<td class="px-4 py-3">{ r.KindLabel }</td>
							<td class="px-4 py-3">{ r.Title }</td>
							<td class="px-4 py-3 text-right">
								<button
									type="button"
									class="text-sm text-red-700 hover:underline dark:text-red-300"
									hx-delete={ r.DeletePath }
									hx-target="#scenario-list"
									hx-swap="innerHTML"
									hx-confirm="Delete this scenario?"
								>Delete</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ ComparePage(p Page, cards []CompareCard) {
	@Layout(p) {
		<h1 class="font-serif text-4xl tracking-tight">Compare</h1>
		<p class="mt-2 text-ink/65"><a href="/dashboard" class="text-brand underline underline-offset-2">Back to dashboard</a></p>
		<div class="mt-8 grid gap-6 md:grid-cols-2">
			for _, card := range cards {
				<section class="rounded-2xl border border-black/5 bg-white/80 p-6 shadow-card dark:border-white/10 dark:bg-white/5">
					<p class="text-xs uppercase tracking-widest text-ink/50">{ card.Kind }</p>
					<h2 class="mt-1 font-serif text-2xl">{ card.Title }</h2>
					<p class="text-sm text-ink/50">{ card.Date }</p>
					<dl class="mt-6 space-y-3">
						for _, row := range card.Rows {
							<div class="flex justify-between gap-4 border-b border-black/5 py-2 text-sm dark:border-white/10">
								<dt class="text-ink/60">{ row.Label }</dt>
								<dd class="font-serif tabular-nums">{ row.Value }</dd>
							</div>
						}
					</dl>
				</section>
			}
		</div>
	}
}

templ CompareError(p Page, msg string) {
	@Layout(p) {
		<h1 class="font-serif text-3xl">Compare</h1>
		<p class="mt-4 text-ink/70">{ msg }</p>
		<p class="mt-4"><a href="/dashboard" class="text-brand underline underline-offset-2">Back to dashboard</a></p>
	}
}
