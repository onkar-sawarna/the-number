package templates

templ FIREPage(p Page) {
	@Layout(p) {
		<div x-data="fireCalc()">
			@CalcNav(p.Path)
			@mobileStickyStat("number_today", "fmtINR(result.fireNumber)", "yearsCopy()")
			<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">@Tx("fire_h1")</h1>
			<p class="mt-2 max-w-2xl text-sm text-ink/65 sm:text-base dark:text-zinc-400" x-show="isIN()">@Tx("fire_intro_in")</p>
			<p class="mt-2 max-w-2xl text-sm text-ink/65 sm:text-base dark:text-zinc-400" x-show="isUS()" x-cloak>@Tx("fire_intro_us")</p>
			<div class="mt-4 flex flex-wrap gap-2">
				<button type="button" class="preset-chip" x-on:click="applyPreset('start')">@Tx("preset_start")</button>
				<button type="button" class="preset-chip" x-on:click="applyPreset('mid')">@Tx("preset_mid")</button>
				<button type="button" class="preset-chip" x-on:click="applyPreset('ahead')">@Tx("preset_ahead")</button>
			</div>
			<form id="fire-form" class="mt-6 grid min-w-0 gap-6 sm:mt-8 sm:gap-8 lg:grid-cols-12" x-on:input="markDirty()" x-on:submit.prevent>
				<div class="min-w-0 space-y-6 lg:col-span-5">
					@labeledRange("age", "age", "age", "18", "70", "1")
					@moneyRange("annual_expenses", "annual_exp", "annualExpenses")
					<div>
						<p class="mb-2 text-sm text-ink/60 dark:text-zinc-400">@Tx("city")</p>
						<div class="grid grid-cols-3 gap-2">
							<button type="button" class="risk-card text-left" x-bind:class="cityTier === 1 ? 'is-on' : ''" x-on:click="cityTier = 1; recalc()">
								<span class="block text-sm font-medium" x-show="isIN()">@Tx("tier1")</span>
								<span class="block text-sm font-medium" x-show="isUS()" x-cloak>@Tx("high_cost")</span>
								<span class="mt-0.5 block text-[11px] text-ink/50 dark:text-zinc-400" x-show="isIN()">@Tx("tier1_sub")</span>
								<span class="mt-0.5 block text-[11px] text-ink/50 dark:text-zinc-400" x-show="isUS()" x-cloak>@Tx("high_cost_sub")</span>
							</button>
							<button type="button" class="risk-card text-left" x-bind:class="cityTier === 2 ? 'is-on' : ''" x-on:click="cityTier = 2; recalc()">
								<span class="block text-sm font-medium" x-show="isIN()">@Tx("tier2")</span>
								<span class="block text-sm font-medium" x-show="isUS()" x-cloak>@Tx("mid_cost")</span>
								<span class="mt-0.5 block text-[11px] text-ink/50 dark:text-zinc-400" x-show="isIN()">@Tx("tier2_sub")</span>
								<span class="mt-0.5 block text-[11px] text-ink/50 dark:text-zinc-400" x-show="isUS()" x-cloak>@Tx("mid_cost_sub")</span>
							</button>
							<button type="button" class="risk-card text-left" x-bind:class="cityTier === 3 ? 'is-on' : ''" x-on:click="cityTier = 3; recalc()">
								<span class="block text-sm font-medium" x-show="isIN()">@Tx("tier3")</span>
								<span class="block text-sm font-medium" x-show="isUS()" x-cloak>@Tx("low_cost")</span>
								<span class="mt-0.5 block text-[11px] text-ink/50 dark:text-zinc-400" x-show="isIN()">@Tx("tier3_sub")</span>
								<span class="mt-0.5 block text-[11px] text-ink/50 dark:text-zinc-400" x-show="isUS()" x-cloak>@Tx("low_cost_sub")</span>
							</button>
						</div>
					</div>
					<div>
						<p class="mb-2 text-sm text-ink/60 dark:text-zinc-400">@Tx("house")</p>
						<div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
							<button type="button" class="risk-card text-left" x-bind:class="housing === 'own' ? 'is-on' : ''" x-on:click="housing = 'own'; recalc()">
								<span class="block text-sm font-medium">@Tx("own")</span>
								<span class="mt-0.5 block text-[11px] text-ink/50 dark:text-zinc-400">@Tx("own_sub")</span>
							</button>
							<button type="button" class="risk-card text-left" x-bind:class="housing === 'rent' ? 'is-on' : ''" x-on:click="housing = 'rent'; recalc()">
								<span class="block text-sm font-medium">@Tx("rent")</span>
								<span class="mt-0.5 block text-[11px] text-ink/50 dark:text-zinc-400">@Tx("rent_sub")</span>
							</button>
							<button type="button" class="risk-card text-left" x-bind:class="housing === 'buy' ? 'is-on' : ''" x-on:click="housing = 'buy'; recalc()">
								<span class="block text-sm font-medium">@Tx("buy")</span>
								<span class="mt-0.5 block text-[11px] text-ink/50 dark:text-zinc-400">@Tx("buy_sub")</span>
							</button>
						</div>
						<p class="mt-2 text-xs text-ink/50 dark:text-zinc-400" x-text="houseCopy()"></p>
					</div>
					<div x-show="isIN()">
						@labeledRange("expected_return", "ret_in", "expectedReturn", "0", "20", "0.1")
					</div>
					<div x-show="isUS()" x-cloak>
						@labeledRange("expected_return_us", "ret_us", "expectedReturn", "0", "20", "0.1")
					</div>
					<div x-show="isIN()">
						@labeledRange("inflation", "inf_in", "inflation", "0", "15", "0.1")
						@labeledRange("swr", "swr_in", "swr", "2", "8", "0.1")
					</div>
					<div x-show="isUS()" x-cloak>
						@labeledRange("inflation_us", "inf_us", "inflation", "0", "15", "0.1")
						@labeledRange("swr_us", "swr_us", "swr", "2", "8", "0.1")
					</div>
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">@Tx("parked_head")</p>
					<div x-show="isIN()">
						@moneyRange("current_savings", "parked_in", "currentSavings")
					</div>
					<div x-show="isUS()" x-cloak>
						@moneyRange("current_savings_us", "parked_us", "currentSavings")
					</div>
					<p class="text-xs leading-relaxed text-ink/50 dark:text-zinc-400" x-text="parkedCopy()"></p>
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">@Tx("gold_head")</p>
					@moneyPair("gold_now", "till_now", "goldNow", "gold_monthly", "monthly", "goldMonthly")
					<p class="text-xs leading-relaxed text-ink/50 dark:text-zinc-400" x-text="goldCopy()"></p>
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">@Tx("jew_head")</p>
					@moneyRange("jewellery_now", "jew_label", "jewelleryNow")
					<p class="text-xs leading-relaxed text-ink/50 dark:text-zinc-400" x-text="jewelleryCopy()"></p>
					<div x-show="isIN()">
						<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">@Tx("nps_head")</p>
						@moneyPair("nps_now", "nps_now", "npsNow", "nps_monthly", "nps_mo", "npsMonthly")
						@moneyPair("epf_now", "epf_now", "epfNow", "epf_monthly", "epf_mo", "epfMonthly")
						@moneyPair("ppf_now", "ppf_now", "ppfNow", "ppf_monthly", "ppf_mo", "ppfMonthly")
						<p class="mt-4 text-xs font-semibold uppercase tracking-[0.18em] text-brand">@Tx("foreign_head")</p>
						@moneyPair("foreign_now", "till_now", "foreignNow", "foreign_monthly", "monthly", "foreignMonthly")
					</div>
					<div x-show="isUS()" x-cloak>
						<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">@Tx("retire_head")</p>
						@moneyPair("nps_now_us", "till_now", "npsNow", "nps_monthly_us", "monthly", "npsMonthly")
					</div>
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">@Tx("invested_head")</p>
					<div x-show="isIN()">
						@moneyPair("stopped_now", "old_sips", "stoppedNow", "monthly_savings", "monthly_sips", "monthlySavings")
					</div>
					<div x-show="isUS()" x-cloak>
						@moneyPair("stopped_now_us", "till_now", "stoppedNow", "monthly_savings_us", "monthly", "monthlySavings")
					</div>
					<p class="text-xs leading-relaxed text-ink/50 dark:text-zinc-400" x-text="investedCopy()"></p>
					@labeledRange("step_up", "step_up", "stepUp", "0", "20", "1")
					<p class="text-xs leading-relaxed text-ink/50 dark:text-zinc-400">@Tx("step_note")</p>
					@deskColCalc()
				</div>
				<div class="min-w-0 lg:col-span-7">
					<div id="calc-result" class="scroll-mt-28 rounded-2xl border border-black/10 bg-white p-4 shadow-card sm:p-6 dark:border-white/25 dark:bg-zinc-950 lg:sticky lg:top-[calc(var(--app-header-h,5.5rem)+1rem)]">
						@deskHeadline("number_today", "fmtINR(result.fireNumber)", "yearsCopy()")
						<div class="mt-4 grid grid-cols-2 gap-2 text-sm sm:gap-3" x-bind:class="dirty ? 'opacity-50' : ''">
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300">@Tx("lifestyle")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.lifestyle)"></p>
							</div>
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300">@Tx("house_add")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.houseAdd)"></p>
							</div>
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300">@Tx("you_have")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.startingCorpus)"></p>
							</div>
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300">@Tx("monthly_in")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.monthlyIn)"></p>
							</div>
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300">@Tx("jew_kept")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.jewellery)"></p>
								<p class="mt-1 text-[11px] text-ink/65 dark:text-zinc-400" x-show="result.jewelleryLater > result.jewellery" x-cloak>@Tx("later")<span class="tabular-nums" x-text="fmtINR(result.jewelleryLater)"></span></p>
							</div>
						</div>
						<div class="mt-4 grid grid-cols-3 gap-2 text-sm sm:gap-3" x-bind:class="dirty ? 'opacity-50' : ''">
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300 sm:text-sm">@Tx("lean")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.lean)"></p>
							</div>
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300 sm:text-sm">@Tx("regular")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.regular)"></p>
							</div>
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300 sm:text-sm">@Tx("fat")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.fat)"></p>
							</div>
						</div>
						@chartKicker("number_today", "fmtINR(result.fireNumber)")
						<p class="mt-1 text-sm text-ink/70 dark:text-zinc-300" x-bind:class="dirty ? 'opacity-50' : ''" x-text="yearsCopy()"></p>
						<div class="mt-3 h-40 min-w-0 overflow-hidden rounded-xl bg-paper sm:h-56 lg:h-64 dark:bg-zinc-900" x-bind:class="dirty ? 'opacity-50' : ''">
							<canvas id="fire-chart"></canvas>
						</div>
						<div class="mt-5" x-show="hasPotLines()" x-cloak>
							<p class="text-xs font-semibold uppercase tracking-widest text-ink/65 dark:text-zinc-300">@Tx("pots_chart")</p>
							<p class="mt-1 text-sm text-ink/65 dark:text-zinc-400">@Tx("pots_chart_sub")</p>
							<p class="mt-1 text-sm font-medium text-ink dark:text-zinc-100" x-text="potsLead()"></p>
							@potMoneyRows()
							<div class="mt-3 h-40 min-w-0 overflow-hidden rounded-xl bg-paper sm:h-56 lg:h-64 dark:bg-zinc-900" x-bind:class="dirty ? 'opacity-50' : ''">
								<canvas id="fire-pots-chart"></canvas>
							</div>
						</div>
					</div>
				</div>
				@phoneEndCalc()
			</form>
		</div>
	}
}

templ SIPPage(p Page) {
	@Layout(p) {
		<div x-data="sipCalc()">
			@CalcNav(p.Path)
			<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">@Tx("sip_h1")</h1>
			<p class="mt-2 max-w-2xl text-sm text-ink/65 sm:text-base dark:text-zinc-400">@Tx("sip_intro")</p>
			<form class="mt-6 grid min-w-0 gap-6 sm:mt-8 sm:gap-8 lg:grid-cols-12" x-on:input="markDirty()" x-on:submit.prevent>
				@mobileStickyStat("future_value", "fmtINR(result.fv)", "")
				<div class="min-w-0 space-y-5 lg:col-span-5">
					@inrRange("monthly", "sip_monthly", "monthly", "500", "500000", "500")
					@inrRange("existing", "sip_existing", "existing", "0", "50000000", "10000")
					@labeledRange("expected_return", "expected_return", "expectedReturn", "0", "20", "0.1")
					@labeledRange("years", "years", "years", "1", "40", "1")
					@deskColCalc()
				</div>
				<div class="min-w-0 lg:col-span-7">
					<div id="calc-result" class="scroll-mt-28 rounded-2xl border border-black/10 bg-white p-4 shadow-card sm:p-6 dark:border-white/25 dark:bg-zinc-950 lg:sticky lg:top-[calc(var(--app-header-h,5.5rem)+1rem)]">
						@deskHeadline("future_value", "fmtINR(result.fv)", "")
						<div class="grid grid-cols-2 gap-2 text-sm sm:gap-3 lg:mt-6" x-bind:class="dirty ? 'opacity-50' : ''">
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300 sm:text-sm">@Tx("invested")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.invested)"></p>
							</div>
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300 sm:text-sm">@Tx("gain")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.gain)"></p>
							</div>
						</div>
						@chartKicker("future_value", "fmtINR(result.fv)")
						<p class="mt-1 text-sm text-ink/70 dark:text-zinc-300" x-bind:class="dirty ? 'opacity-50' : ''">@Tx("invested") <span class="tabular-nums" x-text="fmtINR(result.invested)"></span> · @Tx("gain") <span class="tabular-nums" x-text="fmtINR(result.gain)"></span></p>
						<div class="mt-3 h-40 min-w-0 overflow-hidden rounded-xl bg-paper sm:h-56 lg:h-64 dark:bg-zinc-900" x-bind:class="dirty ? 'opacity-50' : ''">
							<canvas id="sip-chart"></canvas>
						</div>
					</div>
				</div>
				@phoneEndCalc()
			</form>
		</div>
	}
}

templ EMIPage(p Page) {
	@Layout(p) {
		<div x-data="emiCalc()">
			@CalcNav(p.Path)
			<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">@Tx("emi_h1")</h1>
			<p class="mt-2 max-w-2xl text-sm text-ink/65 sm:text-base dark:text-zinc-400">@Tx("emi_intro")</p>
			<form class="mt-6 grid min-w-0 gap-6 sm:mt-8 sm:gap-8 lg:grid-cols-12" x-on:input="markDirty()" x-on:submit.prevent>
				@mobileStickyStat("emi_monthly", "fmtINR(result.emi)", "")
				<div class="min-w-0 space-y-5 lg:col-span-5">
					@inrRange("principal", "principal", "principal", "100000", "100000000", "10000")
					@labeledRange("annual_rate", "annual_rate", "annualRate", "1", "20", "0.1")
					@labeledRange("years", "years", "years", "1", "30", "1")
					@inrRange("extra_monthly", "extra_monthly", "extraMonthly", "0", "200000", "500")
					@inrRange("lump", "lump", "lump", "0", "10000000", "10000")
					@deskColCalc()
				</div>
				<div class="min-w-0 lg:col-span-7">
					<div id="calc-result" class="scroll-mt-28 rounded-2xl border border-black/10 bg-white p-4 shadow-card sm:p-6 dark:border-white/25 dark:bg-zinc-950 lg:sticky lg:top-[calc(var(--app-header-h,5.5rem)+1rem)]">
						@deskHeadline("emi_monthly", "fmtINR(result.emi)", "")
						<div class="grid grid-cols-2 gap-2 text-sm sm:gap-3 lg:mt-6" x-bind:class="dirty ? 'opacity-50' : ''">
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300 sm:text-sm">@Tx("interest_only")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.totalInterest)"></p>
							</div>
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300 sm:text-sm">@Tx("interest_saved")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.interestSaved)"></p>
							</div>
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300 sm:text-sm">@Tx("tenure")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="result.months + t('mo')"></p>
							</div>
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300 sm:text-sm">@Tx("months_saved")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="result.monthsSaved"></p>
							</div>
						</div>
						<div class="mt-5 sm:mt-6" x-bind:class="dirty ? 'opacity-50' : ''">
							<p class="text-xs font-semibold uppercase tracking-widest text-ink/65 dark:text-zinc-300">@Tx("emi_monthly")</p>
							<p class="mt-0.5 font-serif text-2xl tabular-nums tracking-tight sm:text-3xl" x-text="fmtINR(result.emi)"></p>
							<p class="mt-2 text-xs font-semibold uppercase tracking-widest text-ink/65 dark:text-zinc-300">@Tx("you_pay")</p>
							<p class="mt-0.5 font-serif text-xl tabular-nums tracking-tight sm:text-2xl" x-text="fmtINR(result.totalPayment)"></p>
							<p class="mt-1 text-sm text-ink/70 dark:text-zinc-300">@Tx("principal") <span class="tabular-nums" x-text="fmtINR(principal)"></span> · @Tx("interest") <span class="tabular-nums" x-text="fmtINR(result.totalInterest)"></span></p>
							<p class="mt-1 text-sm text-ink/65 dark:text-zinc-400" x-show="result.interestSaved > 0" x-cloak x-text="emiAfterCopy()"></p>
						</div>
						<div class="mt-3 h-40 min-w-0 overflow-hidden rounded-xl bg-paper sm:h-56 lg:h-64 dark:bg-zinc-900" x-bind:class="dirty ? 'opacity-50' : ''">
							<canvas id="emi-chart"></canvas>
						</div>
					</div>
				</div>
				@phoneEndCalc()
			</form>
		</div>
	}
}

templ EmergencyPage(p Page) {
	@Layout(p) {
		<div x-data="emergencyCalc()">
			@CalcNav(p.Path)
			<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">@Tx("em_h1")</h1>
			<p class="mt-2 max-w-2xl text-sm text-ink/65 sm:text-base dark:text-zinc-400">@Tx("em_intro")</p>
			<form class="mt-6 grid min-w-0 gap-6 sm:mt-8 sm:gap-8 lg:grid-cols-12" x-on:input="markDirty()" x-on:submit.prevent>
				@mobileStickyStat("target", "fmtINR(result.target)", "fillCopy()")
				<div class="min-w-0 space-y-5 lg:col-span-5">
					@inrRange("monthly_essentials", "em_essentials", "monthlyEssentials", "5000", "500000", "1000")
					@labeledRange("months_cover", "em_cover", "monthsCover", "1", "24", "1")
					@inrRange("current_buffer", "em_buffer", "currentBuffer", "0", "10000000", "5000")
					@inrRange("monthly_topup", "em_topup", "monthlyTopup", "0", "500000", "500")
					@labeledRange("parking_return", "em_park", "parkingReturn", "0", "12", "0.1")
					@deskColCalc()
				</div>
				<div class="min-w-0 lg:col-span-7">
					<div id="calc-result" class="scroll-mt-28 rounded-2xl border border-black/10 bg-white p-4 shadow-card sm:p-6 dark:border-white/25 dark:bg-zinc-950 lg:sticky lg:top-[calc(var(--app-header-h,5.5rem)+1rem)]">
						@deskHeadline("target", "fmtINR(result.target)", "fillCopy()")
						<div class="grid grid-cols-2 gap-2 text-sm sm:gap-3 lg:mt-6" x-bind:class="dirty ? 'opacity-50' : ''">
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300 sm:text-sm">@Tx("gap")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.gap)"></p>
							</div>
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs text-ink/70 dark:text-zinc-300 sm:text-sm">@Tx("coverage_now")</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="result.coverageNow.toFixed(1) + t('mo')"></p>
							</div>
						</div>
						@chartKicker("target", "fmtINR(result.target)")
						<p class="mt-1 text-sm text-ink/70 dark:text-zinc-300" x-bind:class="dirty ? 'opacity-50' : ''" x-text="fillCopy()"></p>
						<div class="mt-3 h-40 min-w-0 overflow-hidden rounded-xl bg-paper sm:h-56 lg:h-64 dark:bg-zinc-900" x-bind:class="dirty ? 'opacity-50' : ''">
							<canvas id="emergency-chart"></canvas>
						</div>
					</div>
				</div>
				@phoneEndCalc()
			</form>
		</div>
	}
}

templ BudgetPage(p Page) {
	@Layout(p) {
		<div x-data="budgetCalc()">
			@CalcNav(p.Path)
			<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">@Tx("bud_h1")</h1>
			<p class="mt-2 max-w-2xl text-sm text-ink/65 sm:text-base dark:text-zinc-400">@Tx("bud_intro")</p>
			<p class="mt-2 max-w-2xl text-xs leading-relaxed text-ink/55 dark:text-zinc-400">@Tx("bud_hint")</p>
			<form class="mt-6 grid min-w-0 gap-6 sm:mt-8 sm:gap-8 lg:grid-cols-12" x-on:input="markDirty()" x-on:submit.prevent>
				@mobileStickyStat("this_month", "verdict()", "savingsLine()")
				<div class="min-w-0 space-y-5 lg:col-span-5">
					@inrRange("income", "take_home", "income", "10000", "5000000", "1000")
					@inrRange("needs", "needs_in", "needs", "0", "5000000", "1000")
					@inrRange("wants", "wants_in", "wants", "0", "5000000", "1000")
					@inrRange("savings", "save_in", "savings", "0", "5000000", "1000")
					@deskColCalc()
				</div>
				<div class="min-w-0 lg:col-span-7">
					<div id="calc-result" class="scroll-mt-28 rounded-2xl border border-black/10 bg-white p-4 shadow-card sm:p-6 dark:border-white/25 dark:bg-zinc-950 lg:sticky lg:top-[calc(var(--app-header-h,5.5rem)+1rem)]">
						@deskHeadline("this_month", "verdict()", "savingsLine()")
						<div class="grid grid-cols-1 gap-2 text-sm sm:grid-cols-3 sm:gap-3 lg:mt-6" x-bind:class="dirty ? 'opacity-50' : ''">
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs font-medium text-ink/70 dark:text-zinc-300">@Tx("needs50")</p>
								<p class="mt-1 text-[11px] text-ink/55 dark:text-zinc-400">@Tx("cap")<span class="tabular-nums" x-text="fmtINR(result.targetNeeds)"></span></p>
								<p class="font-serif text-lg tabular-nums" x-text="fmtINR(needs)"></p>
								<p class="mt-1 text-[11px] leading-snug text-ink/60 dark:text-zinc-400" x-text="bucketLine('needs')"></p>
							</div>
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs font-medium text-ink/70 dark:text-zinc-300">@Tx("wants30")</p>
								<p class="mt-1 text-[11px] text-ink/55 dark:text-zinc-400">@Tx("cap")<span class="tabular-nums" x-text="fmtINR(result.targetWants)"></span></p>
								<p class="font-serif text-lg tabular-nums" x-text="fmtINR(wants)"></p>
								<p class="mt-1 text-[11px] leading-snug text-ink/60 dark:text-zinc-400" x-text="bucketLine('wants')"></p>
							</div>
							<div class="rounded-xl bg-paper p-2.5 sm:p-3 dark:bg-zinc-800">
								<p class="text-xs font-medium text-ink/70 dark:text-zinc-300">@Tx("save20")</p>
								<p class="mt-1 text-[11px] text-ink/55 dark:text-zinc-400">@Tx("aim")<span class="tabular-nums" x-text="fmtINR(result.targetSavings)"></span></p>
								<p class="font-serif text-lg tabular-nums" x-text="fmtINR(savings)"></p>
								<p class="mt-1 text-[11px] leading-snug text-ink/60 dark:text-zinc-400" x-text="bucketLine('savings')"></p>
							</div>
						</div>
						<p class="mt-3 text-sm text-ink/70 dark:text-zinc-300" x-bind:class="dirty ? 'opacity-50' : ''" x-text="budgetCopy()"></p>
						<p class="mt-5 text-xs font-semibold uppercase tracking-widest text-ink/65 dark:text-zinc-300" x-bind:class="dirty ? 'opacity-50' : ''">@Tx("vs_typed")</p>
						<p class="mt-1 text-sm text-ink/60 dark:text-zinc-400" x-bind:class="dirty ? 'opacity-50' : ''">@Tx("vs_hint")</p>
						<div class="mt-3 h-40 min-w-0 overflow-hidden rounded-xl bg-paper sm:h-56 lg:h-64 dark:bg-zinc-900" x-bind:class="dirty ? 'opacity-50' : ''">
							<canvas id="budget-chart"></canvas>
						</div>
					</div>
				</div>
				@phoneEndCalc()
			</form>
		</div>
	}
}

templ mobileStickyStat(labelKey, expr, subExpr string) {
	<div id="calc-sticky-stat" class="sticky z-10 col-span-full -mx-4 border-b border-black/5 bg-paper/95 px-4 py-3 backdrop-blur dark:border-white/10 dark:bg-night/95 lg:hidden" style="top: var(--app-header-h, 5.5rem);">
		<p class="text-[10px] font-semibold uppercase tracking-widest text-ink/65 dark:text-zinc-300">@Tx(labelKey)</p>
		<p class="mt-0.5 font-serif text-3xl tabular-nums tracking-tight" x-bind:class="dirty ? 'opacity-50' : ''" x-text={ expr }></p>
		if subExpr != "" {
			<p class="mt-1 text-sm text-ink/70 dark:text-zinc-300" x-text={ subExpr }></p>
		}
		<div class="mt-2">
			@calcButton()
		</div>
	</div>
}

templ chartKicker(labelKey, expr string) {
	<div class="mt-5 sm:mt-6" x-bind:class="dirty ? 'opacity-50' : ''">
		<p class="text-xs font-semibold uppercase tracking-widest text-ink/65 dark:text-zinc-300">@Tx(labelKey)</p>
		<p class="mt-0.5 font-serif text-2xl tabular-nums tracking-tight sm:text-3xl" x-text={ expr }></p>
	</div>
}

templ deskHeadline(labelKey, expr, subExpr string) {
	<div class="hidden lg:block">
		<p class="text-xs uppercase tracking-widest text-ink/65 dark:text-zinc-300">@Tx(labelKey)</p>
		<p class="mt-2 font-serif text-5xl tabular-nums" x-bind:class="dirty ? 'opacity-50' : ''" x-text={ expr }></p>
		if subExpr != "" {
			<p class="mt-2 text-sm text-ink/70 dark:text-zinc-300" x-text={ subExpr }></p>
		}
		<div class="mt-4 hidden lg:block">
			@calcButton()
		</div>
	</div>
}

templ labeledRange(name, labelKey, model, min, max, step string) {
	<label class="block text-sm">
		<span class="mb-1 flex items-center justify-between gap-3 text-ink/60 dark:text-zinc-400">
			<span class="min-w-0">@Tx(labelKey)</span>
			<span class="shrink-0 font-serif tabular-nums text-ink dark:text-zinc-100" x-text={ model }></span>
		</span>
		<input type="number" inputmode="decimal" name={ name } x-model.number={ model } min={ min } max={ max } step={ step } x-on:blur="recalc()" x-on:keydown.enter.prevent="$event.target.blur()" class="mt-1 w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 tabular-nums dark:border-white/10 dark:bg-white/5"/>
	</label>
}

templ inrRange(name, labelKey, model, min, max, step string) {
	<label class="block text-sm">
		<span class="mb-1 flex items-center justify-between gap-3 text-ink/60 dark:text-zinc-400">
			<span class="min-w-0">@Tx(labelKey)</span>
			<span class="shrink-0 font-serif tabular-nums text-ink dark:text-zinc-100" x-text={ "fmtINR(" + model + ")" }></span>
		</span>
		@moneyText(name, model)
	</label>
}

templ moneyPair(nowName, nowLabelKey, nowModel, monthName, monthLabelKey, monthModel string) {
	<div class="grid grid-cols-2 gap-2 sm:gap-3">
		<div class="min-w-0">
			@moneyRange(nowName, nowLabelKey, nowModel)
		</div>
		<div class="min-w-0">
			@moneyRange(monthName, monthLabelKey, monthModel)
		</div>
	</div>
}

templ moneyRange(name, labelKey, model string) {
	<label class="block text-sm">
		<span class="mb-1 flex items-center justify-between gap-3 text-ink/60 dark:text-zinc-400">
			<span class="min-w-0">@Tx(labelKey)</span>
			<span class="shrink-0 font-serif tabular-nums text-ink dark:text-zinc-100" x-text={ "fmtINR(" + model + ")" }></span>
		</span>
		@moneyText(name, model)
	</label>
}

templ moneyText(name, model string) {
		<input type="text" inputmode="text" autocomplete="off" name={ name } x-bind:placeholder="moneyHint()" x-effect={ "if (_moneyFocus !== '" + model + "') $el.value = moneyBox('" + model + "')" } x-on:focus={ "_moneyFocus = '" + model + "'; $event.target.select()" } x-on:input.stop="" x-on:blur={ "commitMoney('" + model + "', $event)" } x-on:keydown.enter.prevent={ "commitMoney('" + model + "', $event); $event.target.blur()" } class="mt-1 w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 tabular-nums dark:border-white/10 dark:bg-white/5"/>
}
