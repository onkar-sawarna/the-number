package templates

templ FIREPage(p Page) {
	@Layout(p) {
		<div x-data="fireCalc()">
			@CalcNav(p.Path)
			<h1 class="font-serif text-4xl tracking-tight">FIRE number</h1>
			<p class="mt-2 max-w-2xl text-ink/65 dark:text-zinc-400">The corpus that covers this year’s expenses at your withdrawal rate, and how many years of saving stand between you and it.</p>
			<form id="fire-form" class="mt-8 grid gap-8 lg:grid-cols-12" x-on:input="recalc()">
				<div class="space-y-5 lg:col-span-5">
					@labeledRange("age", "Age", "age", "18", "70", "1")
					@inrRange("annual_expenses", "Annual expenses", "annualExpenses", "120000", "20000000", "10000")
					@inrRange("current_savings", "Current savings", "currentSavings", "0", "100000000", "50000")
					@inrRange("monthly_savings", "Monthly savings", "monthlySavings", "0", "1000000", "1000")
					@labeledRange("expected_return", "Expected return %", "expectedReturn", "0", "20", "0.1")
					@labeledRange("inflation", "Inflation %", "inflation", "0", "15", "0.1")
					@labeledRange("swr", "Safe withdrawal rate %", "swr", "2", "8", "0.1")
				</div>
				<div class="lg:col-span-7">
					<div class="rounded-2xl border border-black/5 bg-white/80 p-6 shadow-card dark:border-white/10 dark:bg-white/5">
						<p class="text-xs uppercase tracking-widest text-ink/50">The number today</p>
						<p class="mt-2 font-serif text-5xl tabular-nums" x-text="fmtINR(result.fireNumber)"></p>
						<p class="mt-2 text-sm text-ink/60" x-text="yearsCopy()"></p>
						<div class="mt-6 grid grid-cols-3 gap-3 text-sm">
							<div class="rounded-xl bg-black/5 p-3 dark:bg-white/5">
								<p class="text-ink/50">Lean</p>
								<p class="font-serif text-lg tabular-nums" x-text="fmtINR(result.lean)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-3 dark:bg-white/5">
								<p class="text-ink/50">Regular</p>
								<p class="font-serif text-lg tabular-nums" x-text="fmtINR(result.regular)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-3 dark:bg-white/5">
								<p class="text-ink/50">Fat</p>
								<p class="font-serif text-lg tabular-nums" x-text="fmtINR(result.fat)"></p>
							</div>
						</div>
						<div class="mt-6 h-56">
							<canvas id="fire-chart"></canvas>
						</div>
					</div>
				</div>
			</form>
		</div>
	}
}

templ SIPPage(p Page) {
	@Layout(p) {
		<div x-data="sipCalc()">
			@CalcNav(p.Path)
			<h1 class="font-serif text-4xl tracking-tight">SIP & compounding</h1>
			<p class="mt-2 max-w-2xl text-ink/65 dark:text-zinc-400">Ordinary annuity, contribution at month-end, monthly compounding.</p>
			<form class="mt-8 grid gap-8 lg:grid-cols-12" x-on:input="recalc()">
				<div class="space-y-5 lg:col-span-5">
					@inrRange("monthly", "Monthly contribution", "monthly", "500", "500000", "500")
					@inrRange("existing", "Existing corpus", "existing", "0", "50000000", "10000")
					@labeledRange("expected_return", "Expected return %", "expectedReturn", "0", "20", "0.1")
					@labeledRange("years", "Years", "years", "1", "40", "1")
				</div>
				<div class="lg:col-span-7">
					<div class="rounded-2xl border border-black/5 bg-white/80 p-6 shadow-card dark:border-white/10 dark:bg-white/5">
						<p class="text-xs uppercase tracking-widest text-ink/50">Future value</p>
						<p class="mt-2 font-serif text-5xl tabular-nums" x-text="fmtINR(result.fv)"></p>
						<div class="mt-6 grid grid-cols-2 gap-3 text-sm">
							<div class="rounded-xl bg-black/5 p-3 dark:bg-white/5">
								<p class="text-ink/50">Invested</p>
								<p class="font-serif text-lg tabular-nums" x-text="fmtINR(result.invested)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-3 dark:bg-white/5">
								<p class="text-ink/50">Gain</p>
								<p class="font-serif text-lg tabular-nums" x-text="fmtINR(result.gain)"></p>
							</div>
						</div>
						<div class="mt-6 h-56">
							<canvas id="sip-chart"></canvas>
						</div>
					</div>
				</div>
			</form>
		</div>
	}
}

templ EMIPage(p Page) {
	@Layout(p) {
		<div x-data="emiCalc()">
			@CalcNav(p.Path)
			<h1 class="font-serif text-4xl tracking-tight">EMI with prepayment</h1>
			<p class="mt-2 max-w-2xl text-ink/65 dark:text-zinc-400">Reducing-balance EMI. Optional extra monthly and a day-one lump.</p>
			<form class="mt-8 grid gap-8 lg:grid-cols-12" x-on:input="recalc()">
				<div class="space-y-5 lg:col-span-5">
					@inrRange("principal", "Principal", "principal", "100000", "100000000", "10000")
					@labeledRange("annual_rate", "Annual rate %", "annualRate", "1", "20", "0.1")
					@labeledRange("years", "Years", "years", "1", "30", "1")
					@inrRange("extra_monthly", "Extra monthly", "extraMonthly", "0", "200000", "500")
					@inrRange("lump", "Day-one lump", "lump", "0", "10000000", "10000")
				</div>
				<div class="lg:col-span-7">
					<div class="rounded-2xl border border-black/5 bg-white/80 p-6 shadow-card dark:border-white/10 dark:bg-white/5">
						<p class="text-xs uppercase tracking-widest text-ink/50">Monthly EMI</p>
						<p class="mt-2 font-serif text-5xl tabular-nums" x-text="fmtINR(result.emi)"></p>
						<div class="mt-6 grid grid-cols-2 gap-3 text-sm">
							<div class="rounded-xl bg-black/5 p-3 dark:bg-white/5">
								<p class="text-ink/50">Interest (schedule)</p>
								<p class="font-serif text-lg tabular-nums" x-text="fmtINR(result.totalInterest)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-3 dark:bg-white/5">
								<p class="text-ink/50">Interest saved</p>
								<p class="font-serif text-lg tabular-nums" x-text="fmtINR(result.interestSaved)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-3 dark:bg-white/5">
								<p class="text-ink/50">Tenure</p>
								<p class="font-serif text-lg tabular-nums" x-text="result.months + ' mo'"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-3 dark:bg-white/5">
								<p class="text-ink/50">Months saved</p>
								<p class="font-serif text-lg tabular-nums" x-text="result.monthsSaved"></p>
							</div>
						</div>
						<div class="mt-6 h-56">
							<canvas id="emi-chart"></canvas>
						</div>
					</div>
				</div>
			</form>
		</div>
	}
}

templ EmergencyPage(p Page) {
	@Layout(p) {
		<div x-data="emergencyCalc()">
			@CalcNav(p.Path)
			<h1 class="font-serif text-4xl tracking-tight">Emergency fund</h1>
			<p class="mt-2 max-w-2xl text-ink/65 dark:text-zinc-400">Target cover, the gap, and months to fill it with a top-up.</p>
			<form class="mt-8 grid gap-8 lg:grid-cols-12" x-on:input="recalc()">
				<div class="space-y-5 lg:col-span-5">
					@inrRange("monthly_essentials", "Monthly essentials", "monthlyEssentials", "5000", "500000", "1000")
					@labeledRange("months_cover", "Months of cover", "monthsCover", "1", "24", "1")
					@inrRange("current_buffer", "Current buffer", "currentBuffer", "0", "10000000", "5000")
					@inrRange("monthly_topup", "Monthly top-up", "monthlyTopup", "0", "500000", "500")
					@labeledRange("parking_return", "Parking return %", "parkingReturn", "0", "12", "0.1")
				</div>
				<div class="lg:col-span-7">
					<div class="rounded-2xl border border-black/5 bg-white/80 p-6 shadow-card dark:border-white/10 dark:bg-white/5">
						<p class="text-xs uppercase tracking-widest text-ink/50">Target</p>
						<p class="mt-2 font-serif text-5xl tabular-nums" x-text="fmtINR(result.target)"></p>
						<p class="mt-2 text-sm text-ink/60" x-text="fillCopy()"></p>
						<div class="mt-6 grid grid-cols-2 gap-3 text-sm">
							<div class="rounded-xl bg-black/5 p-3 dark:bg-white/5">
								<p class="text-ink/50">Gap</p>
								<p class="font-serif text-lg tabular-nums" x-text="fmtINR(result.gap)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-3 dark:bg-white/5">
								<p class="text-ink/50">Coverage now</p>
								<p class="font-serif text-lg tabular-nums" x-text="result.coverageNow.toFixed(1) + ' mo'"></p>
							</div>
						</div>
						<div class="mt-6 h-56">
							<canvas id="emergency-chart"></canvas>
						</div>
					</div>
				</div>
			</form>
		</div>
	}
}

templ BudgetPage(p Page) {
	@Layout(p) {
		<div x-data="budgetCalc()">
			@CalcNav(p.Path)
			<h1 class="font-serif text-4xl tracking-tight">50/30/20 budget</h1>
			<p class="mt-2 max-w-2xl text-ink/65 dark:text-zinc-400">Needs, wants, and savings against take-home pay.</p>
			<form class="mt-8 grid gap-8 lg:grid-cols-12" x-on:input="recalc()">
				<div class="space-y-5 lg:col-span-5">
					@inrRange("income", "Take-home income", "income", "10000", "5000000", "1000")
					@inrRange("needs", "Needs (actual)", "needs", "0", "5000000", "1000")
					@inrRange("wants", "Wants (actual)", "wants", "0", "5000000", "1000")
					@inrRange("savings", "Savings (actual)", "savings", "0", "5000000", "1000")
				</div>
				<div class="lg:col-span-7">
					<div class="rounded-2xl border border-black/5 bg-white/80 p-6 shadow-card dark:border-white/10 dark:bg-white/5">
						<p class="text-xs uppercase tracking-widest text-ink/50">Savings rate</p>
						<p class="mt-2 font-serif text-5xl tabular-nums" x-text="result.savingsRate.toFixed(1) + '%'"></p>
						<p class="mt-2 text-sm" x-bind:class="result.overspent ? 'text-red-700 dark:text-red-300' : 'text-ink/60'" x-text="budgetCopy()"></p>
						<div class="mt-6 grid grid-cols-3 gap-3 text-sm">
							<div class="rounded-xl bg-black/5 p-3 dark:bg-white/5">
								<p class="text-ink/50">Needs 50%</p>
								<p class="font-serif tabular-nums" x-text="fmtINR(result.targetNeeds)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-3 dark:bg-white/5">
								<p class="text-ink/50">Wants 30%</p>
								<p class="font-serif tabular-nums" x-text="fmtINR(result.targetWants)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-3 dark:bg-white/5">
								<p class="text-ink/50">Savings 20%</p>
								<p class="font-serif tabular-nums" x-text="fmtINR(result.targetSavings)"></p>
							</div>
						</div>
						<div class="mt-6 h-56">
							<canvas id="budget-chart"></canvas>
						</div>
					</div>
				</div>
			</form>
		</div>
	}
}

templ labeledRange(name, label, model, min, max, step string) {
	<label class="block text-sm">
		<span class="mb-1 flex items-center justify-between text-ink/60 dark:text-zinc-400">
			<span>{ label }</span>
			<span class="font-serif tabular-nums text-ink dark:text-zinc-100" x-text={ model }></span>
		</span>
		<input type="range" x-model.number={ model } min={ min } max={ max } step={ step } class="w-full"/>
		<input type="number" name={ name } x-model.number={ model } min={ min } max={ max } step={ step } class="mt-2 w-full rounded-xl border border-black/10 bg-white px-3 py-2 tabular-nums dark:border-white/10 dark:bg-white/5"/>
	</label>
}

templ inrRange(name, label, model, min, max, step string) {
	<label class="block text-sm">
		<span class="mb-1 flex items-center justify-between text-ink/60 dark:text-zinc-400">
			<span>{ label }</span>
			<span class="font-serif tabular-nums text-ink dark:text-zinc-100" x-text={ "fmtINR(" + model + ")" }></span>
		</span>
		<input type="range" x-model.number={ model } min={ min } max={ max } step={ step } class="w-full"/>
		<input type="number" name={ name } x-model.number={ model } min={ min } max={ max } step={ step } class="mt-2 w-full rounded-xl border border-black/10 bg-white px-3 py-2 tabular-nums dark:border-white/10 dark:bg-white/5"/>
	</label>
}
