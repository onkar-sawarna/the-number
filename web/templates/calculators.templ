package templates

templ FIREPage(p Page) {
	@Layout(p) {
		<div x-data="fireCalc()">
			@CalcNav(p.Path)
			@mobileStickyStat("The number today", "fmtINR(result.fireNumber)", "yearsCopy()")
			<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">FIRE number</h1>
			<p class="mt-2 max-w-2xl text-sm text-ink/65 sm:text-base dark:text-zinc-400" x-show="isIN()">Parked cash at ~6%. Gold at ~8%. Invested SIPs — old ones still in funds, plus SIPs still running — at your expected return. Then NPS, EPF, PPF, foreign stocks, and housing.</p>
			<p class="mt-2 max-w-2xl text-sm text-ink/65 sm:text-base dark:text-zinc-400" x-show="isUS()" x-cloak>Parked cash at ~6%. Gold at ~8%. Invested pots at your expected return. Then a retirement account and housing. Amounts are in dollars.</p>
			<div class="mt-4 flex flex-wrap gap-2">
				<button type="button" class="preset-chip" x-on:click="applyPreset('start')">Just starting</button>
				<button type="button" class="preset-chip" x-on:click="applyPreset('mid')">Saving hard</button>
				<button type="button" class="preset-chip" x-on:click="applyPreset('ahead')">Already a stash</button>
			</div>
			<form id="fire-form" class="mt-6 grid min-w-0 gap-6 sm:mt-8 sm:gap-8 lg:grid-cols-12" x-on:input="markDirty()" x-on:submit.prevent="recalc()">
				<div class="min-w-0 space-y-6 lg:col-span-5">
					@labeledRange("age", "Age", "age", "18", "70", "1")
					@moneyRange("annual_expenses", "Annual expenses (include rent if you rent)", "annualExpenses")
					<div>
						<p class="mb-2 text-sm text-ink/60 dark:text-zinc-400">City</p>
						<div class="grid grid-cols-3 gap-2">
							<button type="button" class="risk-card text-left" x-bind:class="cityTier === 1 ? 'is-on' : ''" x-on:click="cityTier = 1; markDirty()">
								<span class="block text-sm font-medium" x-show="isIN()">Tier 1</span>
								<span class="block text-sm font-medium" x-show="isUS()" x-cloak>High cost</span>
								<span class="mt-0.5 block text-[11px] text-ink/50" x-show="isIN()">Metro</span>
								<span class="mt-0.5 block text-[11px] text-ink/50" x-show="isUS()" x-cloak>Coast / capital</span>
							</button>
							<button type="button" class="risk-card text-left" x-bind:class="cityTier === 2 ? 'is-on' : ''" x-on:click="cityTier = 2; markDirty()">
								<span class="block text-sm font-medium" x-show="isIN()">Tier 2</span>
								<span class="block text-sm font-medium" x-show="isUS()" x-cloak>Mid cost</span>
								<span class="mt-0.5 block text-[11px] text-ink/50" x-show="isIN()">Big town</span>
								<span class="mt-0.5 block text-[11px] text-ink/50" x-show="isUS()" x-cloak>Regional city</span>
							</button>
							<button type="button" class="risk-card text-left" x-bind:class="cityTier === 3 ? 'is-on' : ''" x-on:click="cityTier = 3; markDirty()">
								<span class="block text-sm font-medium" x-show="isIN()">Tier 3</span>
								<span class="block text-sm font-medium" x-show="isUS()" x-cloak>Lower cost</span>
								<span class="mt-0.5 block text-[11px] text-ink/50" x-show="isIN()">Smaller city</span>
								<span class="mt-0.5 block text-[11px] text-ink/50" x-show="isUS()" x-cloak>Smaller city</span>
							</button>
						</div>
					</div>
					<div>
						<p class="mb-2 text-sm text-ink/60 dark:text-zinc-400">House</p>
						<div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
							<button type="button" class="risk-card text-left" x-bind:class="housing === 'own' ? 'is-on' : ''" x-on:click="housing = 'own'; markDirty()">
								<span class="block text-sm font-medium">I own</span>
								<span class="mt-0.5 block text-[11px] text-ink/50">No extra corpus</span>
							</button>
							<button type="button" class="risk-card text-left" x-bind:class="housing === 'rent' ? 'is-on' : ''" x-on:click="housing = 'rent'; markDirty()">
								<span class="block text-sm font-medium">I’ll keep renting</span>
								<span class="mt-0.5 block text-[11px] text-ink/50">Rent stays in expenses</span>
							</button>
							<button type="button" class="risk-card text-left" x-bind:class="housing === 'buy' ? 'is-on' : ''" x-on:click="housing = 'buy'; markDirty()">
								<span class="block text-sm font-medium">I rent, I’ll buy</span>
								<span class="mt-0.5 block text-[11px] text-ink/50">House added; keep rent for now</span>
							</button>
						</div>
						<p class="mt-2 text-xs text-ink/50 dark:text-zinc-500" x-text="houseCopy()"></p>
					</div>
					<div x-show="isIN()">
						@labeledRange("expected_return", "Expected return % (invested SIPs + foreign)", "expectedReturn", "0", "20", "0.1")
					</div>
					<div x-show="isUS()" x-cloak>
						@labeledRange("expected_return_us", "Expected return % (invested + retirement)", "expectedReturn", "0", "20", "0.1")
					</div>
					@labeledRange("inflation", "Inflation %", "inflation", "0", "15", "0.1")
					@labeledRange("swr", "Safe withdrawal rate %", "swr", "2", "8", "0.1")
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">Parked · ~6%</p>
					<div x-show="isIN()">
						@moneyRange("current_savings", "Cash, FDs, liquid funds till now", "currentSavings")
					</div>
					<div x-show="isUS()" x-cloak>
						@moneyRange("current_savings_us", "Cash & savings till now", "currentSavings")
					</div>
					<p class="text-xs leading-relaxed text-ink/50 dark:text-zinc-500" x-text="parkedCopy()"></p>
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">Gold · ~8%</p>
					@moneyRange("gold_now", "Gold till now", "goldNow")
					@moneyRange("gold_monthly", "Gold monthly", "goldMonthly")
					<p class="text-xs leading-relaxed text-ink/50 dark:text-zinc-500" x-text="goldCopy()"></p>
					<div x-show="isIN()">
						<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">NPS · EPF · PPF</p>
						@moneyRange("nps_now", "NPS till now", "npsNow")
						@moneyRange("nps_monthly", "NPS monthly contribution", "npsMonthly")
						@moneyRange("epf_now", "EPF till now", "epfNow")
						@moneyRange("epf_monthly", "EPF monthly contribution", "epfMonthly")
						@moneyRange("ppf_now", "PPF till now", "ppfNow")
						@moneyRange("ppf_monthly", "PPF monthly contribution", "ppfMonthly")
						<p class="mt-4 text-xs font-semibold uppercase tracking-[0.18em] text-brand">Foreign stocks</p>
						@moneyRange("foreign_now", "Foreign stocks till now", "foreignNow")
						@moneyRange("foreign_monthly", "Foreign stocks monthly", "foreignMonthly")
					</div>
					<div x-show="isUS()" x-cloak>
						<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">Retirement account</p>
						@moneyRange("nps_now_us", "Retirement account till now", "npsNow")
						@moneyRange("nps_monthly_us", "Retirement account monthly", "npsMonthly")
					</div>
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">Invested · expected return</p>
					<div x-show="isIN()">
						@moneyRange("stopped_now", "Already invested (old SIPs still in funds)", "stoppedNow")
						@moneyRange("monthly_savings", "Monthly SIPs still running", "monthlySavings")
					</div>
					<div x-show="isUS()" x-cloak>
						@moneyRange("stopped_now_us", "Already invested", "stoppedNow")
						@moneyRange("monthly_savings_us", "Monthly contributions still running", "monthlySavings")
					</div>
					<p class="text-xs leading-relaxed text-ink/50 dark:text-zinc-500" x-text="investedCopy()"></p>
				</div>
				<div class="min-w-0 lg:col-span-7">
					<div class="rounded-2xl border border-black/5 bg-white/80 p-4 shadow-card sm:p-6 dark:border-white/10 dark:bg-white/5">
						@deskHeadline("The number today", "fmtINR(result.fireNumber)", "yearsCopy()")
						<div class="mt-4 grid grid-cols-2 gap-2 text-sm sm:gap-3" x-bind:class="dirty ? 'opacity-50' : ''">
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50">Lifestyle corpus</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.lifestyle)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50">House add-on</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.houseAdd)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50">You have today</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.startingCorpus)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50">Monthly going in</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.monthlyIn)"></p>
							</div>
						</div>
						<div class="mt-4 grid grid-cols-3 gap-2 text-sm sm:gap-3" x-bind:class="dirty ? 'opacity-50' : ''">
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50 sm:text-sm">Lean</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.lean)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50 sm:text-sm">Regular</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.regular)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50 sm:text-sm">Fat</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.fat)"></p>
							</div>
						</div>
						<div class="mt-5 h-48 min-w-0 overflow-hidden sm:mt-6 sm:h-56 lg:h-64" x-bind:class="dirty ? 'opacity-50' : ''">
							<canvas id="fire-chart"></canvas>
						</div>
					</div>
				</div>
			</form>
		</div>
	}
}

templ SIPPage(p Page) {
	@Layout(p) {
		<div x-data="sipCalc()">
			@CalcNav(p.Path)
			<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">SIP & compounding</h1>
			<p class="mt-2 max-w-2xl text-sm text-ink/65 sm:text-base dark:text-zinc-400">Leave a contribution running. See what it becomes — month-end SIPs, monthly compounding, no brochure.</p>
			<form class="mt-6 grid min-w-0 gap-6 sm:mt-8 sm:gap-8 lg:grid-cols-12" x-on:input="markDirty()" x-on:submit.prevent="recalc()">
				@mobileStickyStat("Future value", "fmtINR(result.fv)", "")
				<div class="min-w-0 space-y-5 lg:col-span-5">
					@inrRange("monthly", "Monthly contribution", "monthly", "500", "500000", "500")
					@inrRange("existing", "Existing corpus", "existing", "0", "50000000", "10000")
					@labeledRange("expected_return", "Expected return %", "expectedReturn", "0", "20", "0.1")
					@labeledRange("years", "Years", "years", "1", "40", "1")
				</div>
				<div class="min-w-0 lg:col-span-7">
					<div class="rounded-2xl border border-black/5 bg-white/80 p-4 shadow-card sm:p-6 dark:border-white/10 dark:bg-white/5">
						@deskHeadline("Future value", "fmtINR(result.fv)", "")
						<div class="grid grid-cols-2 gap-2 text-sm sm:gap-3 lg:mt-6" x-bind:class="dirty ? 'opacity-50' : ''">
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50 sm:text-sm">Invested</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.invested)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50 sm:text-sm">Gain</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.gain)"></p>
							</div>
						</div>
						<div class="mt-5 h-48 min-w-0 overflow-hidden sm:mt-6 sm:h-56 lg:h-64" x-bind:class="dirty ? 'opacity-50' : ''">
							<canvas id="sip-chart"></canvas>
						</div>
					</div>
				</div>
			</form>
		</div>
	}
}

templ EMIPage(p Page) {
	@Layout(p) {
		<div x-data="emiCalc()">
			@CalcNav(p.Path)
			<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">EMI with prepayment</h1>
			<p class="mt-2 max-w-2xl text-sm text-ink/65 sm:text-base dark:text-zinc-400">What if you throw extra at it? Reducing-balance EMI, then extra monthly or a day-one lump.</p>
			<form class="mt-6 grid min-w-0 gap-6 sm:mt-8 sm:gap-8 lg:grid-cols-12" x-on:input="markDirty()" x-on:submit.prevent="recalc()">
				@mobileStickyStat("Monthly EMI", "fmtINR(result.emi)", "")
				<div class="min-w-0 space-y-5 lg:col-span-5">
					@inrRange("principal", "Principal", "principal", "100000", "100000000", "10000")
					@labeledRange("annual_rate", "Annual rate %", "annualRate", "1", "20", "0.1")
					@labeledRange("years", "Years", "years", "1", "30", "1")
					@inrRange("extra_monthly", "Extra monthly", "extraMonthly", "0", "200000", "500")
					@inrRange("lump", "Day-one lump", "lump", "0", "10000000", "10000")
				</div>
				<div class="min-w-0 lg:col-span-7">
					<div class="rounded-2xl border border-black/5 bg-white/80 p-4 shadow-card sm:p-6 dark:border-white/10 dark:bg-white/5">
						@deskHeadline("Monthly EMI", "fmtINR(result.emi)", "")
						<div class="grid grid-cols-2 gap-2 text-sm sm:gap-3 lg:mt-6" x-bind:class="dirty ? 'opacity-50' : ''">
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50 sm:text-sm">Interest (schedule)</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.totalInterest)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50 sm:text-sm">Interest saved</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.interestSaved)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50 sm:text-sm">Tenure</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="result.months + ' mo'"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50 sm:text-sm">Months saved</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="result.monthsSaved"></p>
							</div>
						</div>
						<div class="mt-5 h-48 min-w-0 overflow-hidden sm:mt-6 sm:h-56 lg:h-64" x-bind:class="dirty ? 'opacity-50' : ''">
							<canvas id="emi-chart"></canvas>
						</div>
					</div>
				</div>
			</form>
		</div>
	}
}

templ EmergencyPage(p Page) {
	@Layout(p) {
		<div x-data="emergencyCalc()">
			@CalcNav(p.Path)
			<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">Emergency fund</h1>
			<p class="mt-2 max-w-2xl text-sm text-ink/65 sm:text-base dark:text-zinc-400">How many months of runway, the gap, and how fast a top-up closes it.</p>
			<form class="mt-6 grid min-w-0 gap-6 sm:mt-8 sm:gap-8 lg:grid-cols-12" x-on:input="markDirty()" x-on:submit.prevent="recalc()">
				@mobileStickyStat("Target", "fmtINR(result.target)", "fillCopy()")
				<div class="min-w-0 space-y-5 lg:col-span-5">
					@inrRange("monthly_essentials", "Monthly essentials", "monthlyEssentials", "5000", "500000", "1000")
					@labeledRange("months_cover", "Months of cover", "monthsCover", "1", "24", "1")
					@inrRange("current_buffer", "Current buffer", "currentBuffer", "0", "10000000", "5000")
					@inrRange("monthly_topup", "Monthly top-up", "monthlyTopup", "0", "500000", "500")
					@labeledRange("parking_return", "Parking return %", "parkingReturn", "0", "12", "0.1")
				</div>
				<div class="min-w-0 lg:col-span-7">
					<div class="rounded-2xl border border-black/5 bg-white/80 p-4 shadow-card sm:p-6 dark:border-white/10 dark:bg-white/5">
						@deskHeadline("Target", "fmtINR(result.target)", "fillCopy()")
						<div class="grid grid-cols-2 gap-2 text-sm sm:gap-3 lg:mt-6" x-bind:class="dirty ? 'opacity-50' : ''">
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50 sm:text-sm">Gap</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.gap)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50 sm:text-sm">Coverage now</p>
								<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="result.coverageNow.toFixed(1) + ' mo'"></p>
							</div>
						</div>
						<div class="mt-5 h-48 min-w-0 overflow-hidden sm:mt-6 sm:h-56 lg:h-64" x-bind:class="dirty ? 'opacity-50' : ''">
							<canvas id="emergency-chart"></canvas>
						</div>
					</div>
				</div>
			</form>
		</div>
	}
}

templ BudgetPage(p Page) {
	@Layout(p) {
		<div x-data="budgetCalc()">
			@CalcNav(p.Path)
			<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">50/30/20 budget</h1>
			<p class="mt-2 max-w-2xl text-sm text-ink/65 sm:text-base dark:text-zinc-400">Needs, wants, savings vs take-home. A yes/no on whether the month is overspent.</p>
			<form class="mt-6 grid min-w-0 gap-6 sm:mt-8 sm:gap-8 lg:grid-cols-12" x-on:input="markDirty()" x-on:submit.prevent="recalc()">
				@mobileStickyStat("Savings rate", "result.savingsRate.toFixed(1) + '%'", "budgetCopy()")
				<div class="min-w-0 space-y-5 lg:col-span-5">
					@inrRange("income", "Take-home income", "income", "10000", "5000000", "1000")
					@inrRange("needs", "Needs (actual)", "needs", "0", "5000000", "1000")
					@inrRange("wants", "Wants (actual)", "wants", "0", "5000000", "1000")
					@inrRange("savings", "Savings (actual)", "savings", "0", "5000000", "1000")
				</div>
				<div class="min-w-0 lg:col-span-7">
					<div class="rounded-2xl border border-black/5 bg-white/80 p-4 shadow-card sm:p-6 dark:border-white/10 dark:bg-white/5">
						@deskHeadline("Savings rate", "result.savingsRate.toFixed(1) + '%'", "budgetCopy()")
						<div class="grid grid-cols-3 gap-2 text-sm sm:gap-3 lg:mt-6" x-bind:class="dirty ? 'opacity-50' : ''">
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50 sm:text-sm">Needs 50%</p>
								<p class="font-serif text-sm tabular-nums sm:text-base" x-text="fmtINR(result.targetNeeds)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50 sm:text-sm">Wants 30%</p>
								<p class="font-serif text-sm tabular-nums sm:text-base" x-text="fmtINR(result.targetWants)"></p>
							</div>
							<div class="rounded-xl bg-black/5 p-2.5 sm:p-3 dark:bg-white/5">
								<p class="text-xs text-ink/50 sm:text-sm">Savings 20%</p>
								<p class="font-serif text-sm tabular-nums sm:text-base" x-text="fmtINR(result.targetSavings)"></p>
							</div>
						</div>
						<div class="mt-5 h-48 min-w-0 overflow-hidden sm:mt-6 sm:h-56 lg:h-64" x-bind:class="dirty ? 'opacity-50' : ''">
							<canvas id="budget-chart"></canvas>
						</div>
					</div>
				</div>
			</form>
		</div>
	}
}

templ mobileStickyStat(label, expr, subExpr string) {
	<div class="sticky z-10 col-span-full -mx-4 border-b border-black/5 bg-paper/95 px-4 py-3 backdrop-blur dark:border-white/10 dark:bg-night/95 lg:hidden" style="top: var(--app-header-h, 5.5rem);">
		<p class="text-[10px] font-semibold uppercase tracking-widest text-ink/50">{ label }</p>
		<p class="mt-0.5 font-serif text-3xl tabular-nums tracking-tight" x-bind:class="dirty ? 'opacity-50' : ''" x-text={ expr }></p>
		if subExpr != "" {
			<p class="mt-1 text-sm text-ink/70 dark:text-zinc-300" x-text={ subExpr }></p>
		}
		<div class="mt-2">
			@calcButton()
		</div>
	</div>
}

templ deskHeadline(label, expr, subExpr string) {
	<div class="hidden lg:block">
		<p class="text-xs uppercase tracking-widest text-ink/50">{ label }</p>
		<p class="mt-2 font-serif text-5xl tabular-nums" x-bind:class="dirty ? 'opacity-50' : ''" x-text={ expr }></p>
		if subExpr != "" {
			<p class="mt-2 text-sm text-ink/60" x-text={ subExpr }></p>
		}
		<div class="mt-4 hidden lg:block">
			@calcButton()
		</div>
	</div>
}

templ labeledRange(name, label, model, min, max, step string) {
	<label class="block text-sm">
		<span class="mb-1 flex items-center justify-between gap-3 text-ink/60 dark:text-zinc-400">
			<span class="min-w-0">{ label }</span>
			<span class="shrink-0 font-serif tabular-nums text-ink dark:text-zinc-100" x-text={ model }></span>
		</span>
		<input type="range" x-model.number={ model } min={ min } max={ max } step={ step } class="w-full"/>
		<input type="number" inputmode="decimal" name={ name } x-model.number={ model } min={ min } max={ max } step={ step } class="mt-1 w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 tabular-nums dark:border-white/10 dark:bg-white/5"/>
	</label>
}

templ inrRange(name, label, model, min, max, step string) {
	<label class="block text-sm">
		<span class="mb-1 flex items-center justify-between gap-3 text-ink/60 dark:text-zinc-400">
			<span class="min-w-0">{ label }</span>
			<span class="shrink-0 font-serif tabular-nums text-ink dark:text-zinc-100" x-text={ "fmtINR(" + model + ")" }></span>
		</span>
		<input type="range" x-model.number={ model } min={ min } max={ max } step={ step } class="w-full"/>
		<input type="number" inputmode="decimal" name={ name } x-model.number={ model } min={ min } max={ max } step={ step } class="mt-1 w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 tabular-nums dark:border-white/10 dark:bg-white/5"/>
	</label>
}

templ moneyRange(name, label, model string) {
	<label class="block text-sm">
		<span class="mb-1 flex items-center justify-between gap-3 text-ink/60 dark:text-zinc-400">
			<span class="min-w-0">{ label }</span>
			<span class="shrink-0 font-serif tabular-nums text-ink dark:text-zinc-100" x-text={ "fmtINR(" + model + ")" }></span>
		</span>
		<input type="range" x-model.number={ model } x-bind:min={ "rangeMin('" + model + "')" } x-bind:max={ "rangeMax('" + model + "')" } x-bind:step={ "rangeStep('" + model + "')" } class="w-full"/>
		<input type="number" inputmode="decimal" name={ name } x-model.number={ model } x-bind:min={ "rangeMin('" + model + "')" } x-bind:max={ "rangeMax('" + model + "')" } x-bind:step={ "rangeStep('" + model + "')" } class="mt-1 w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 tabular-nums dark:border-white/10 dark:bg-white/5"/>
	</label>
}
