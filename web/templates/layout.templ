		</li>
		<li>
			<a href="https://www.linkedin.com/in/onkar-sawarna-569615187/" target="_blank" rel="me noopener noreferrer" aria-label="Onkar Sawarna on LinkedIn">
				<svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true"><path class="social-ink" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"></path></svg>
				LinkedIn
			</a>
		</li>
		<li>
			<a href="https://x.com/onkar_sawarna" target="_blank" rel="me noopener noreferrer" aria-label="Onkar Sawarna on X">
				<svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true"><path class="social-ink" d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path></svg>
				X
			</a>
		</li>
		<li>
			<a href="mailto:onkarsawarna@gmail.com" rel="me" aria-label="Email">
				<svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true"><path class="social-ink" d="M1.5 8.67v8.58A2.25 2.25 0 0 0 3.75 19.5h16.5a2.25 2.25 0 0 0 2.25-2.25V8.67l-8.928 5.493a3.75 3.75 0 0 1-4.144 0L1.5 8.67Z"></path><path class="social-ink" d="M22.5 6.908V6.75a2.25 2.25 0 0 0-2.25-2.25H3.75A2.25 2.25 0 0 0 1.5 6.75v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z"></path></svg>
				Email
			</a>
		</li>
	</ul>
}

templ RegionToggle() {
	<div class="flex shrink-0 rounded-full border border-black/10 p-0.5 text-[11px] font-medium dark:border-white/15" x-data="regionCtl()" role="group" aria-label="India or rest of world">
		<button type="button" class="min-h-9 rounded-full px-2.5 py-1 sm:px-3" x-bind:class="region === 'in' ? 'bg-brand text-white' : 'text-ink/70 dark:text-zinc-300'" x-on:click="set('in')" aria-label="India rupees">@Tx("region_in")</button>
		<button type="button" class="min-h-9 rounded-full px-2.5 py-1 sm:px-3" x-bind:class="region === 'us' ? 'bg-brand text-white' : 'text-ink/70 dark:text-zinc-300'" x-on:click="set('us')" aria-label="World dollars">@Tx("region_us")</button>
	</div>
}

templ CalcNav(path string) {
	<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center">
		<nav class="-mx-4 min-w-0 overflow-x-auto px-4 pb-1 no-scrollbar sm:mx-0 sm:flex-1 sm:overflow-visible sm:px-0">
			<div class="flex w-max gap-2 sm:w-auto sm:flex-wrap">
				<a href="/calculators/fire" class={ TabClass(path, "/calculators/fire") }>@Tx("tab_fire")</a>
				<a href="/calculators/sip" class={ TabClass(path, "/calculators/sip") }>@Tx("tab_sip")</a>
				<a href="/calculators/emi" class={ TabClass(path, "/calculators/emi") }>@Tx("tab_emi")</a>
				<a href="/calculators/emergency" class={ TabClass(path, "/calculators/emergency") }>@Tx("tab_emergency")</a>
				<a href="/calculators/budget" class={ TabClass(path, "/calculators/budget") }>@Tx("tab_budget")</a>
			</div>
		</nav>
		@RegionToggle()
	</div>
}

templ PageTrail(p Page) {
	if p.Path != "/" {
		<nav class="mb-5 flex flex-wrap items-center gap-2 text-sm" aria-label="Breadcrumb">
			<a href="/" class="font-medium text-brand hover:underline">@Tx("nav_home")</a>
			<span class="text-ink/30 dark:text-zinc-600" aria-hidden="true">/</span>
			<span class="text-ink/70 dark:text-zinc-300">@Tx(p.TitleKey)</span>
		</nav>
	}
}

templ JumpRow(path string) {
	if path != "/" {
		<nav class="mt-10 hidden flex-wrap gap-2 md:flex" aria-label="Continue">
			<a href="/" class="btn-ghost">@Tx("jump_home")</a>
			if !IsCalc(path) {
				<a href="/calculators/fire" class="btn-ghost">@Tx("jump_fire")</a>
			}
			if path != "/about" {
				<a href="/about" class="btn-ghost">@Tx("jump_about")</a>
			}
		</nav>
	}
}

templ Dock(p Page) {
	<nav class="dock md:hidden" aria-label="App">
		<a href="/" class={ DockClass(p.Path, "/") }>
			<span>@Tx("nav_home")</span>
		</a>
		<a href="/calculators/fire" class={ DockClass(p.Path, "/calculators/fire") }>
			<span>@Tx("nav_fire")</span>
		</a>
		<a href="/about" class={ DockClass(p.Path, "/about") }>
			<span>@Tx("nav_about")</span>
		</a>
	</nav>
}
