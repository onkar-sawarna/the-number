package templates

templ GuidancePage(p Page) {
	@Layout(p) {
		<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">@Tx("guide_h1")</h1>
		<p class="mt-2 max-w-2xl text-sm text-ink/65 sm:text-base dark:text-zinc-400">@Tx("guide_intro")</p>
		<form class="mt-6 grid min-w-0 gap-6 sm:mt-8 sm:gap-8 lg:grid-cols-12" hx-post="/guidance" hx-target="#guidance-result" hx-swap="innerHTML" hx-indicator="#guide-ind" x-data="guideForm()">
			<div class="min-w-0 space-y-5 lg:col-span-5">
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60 dark:text-zinc-400">@Tx("age")</span>
					<input type="number" inputmode="numeric" name="age" value="30" min="18" max="90" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 dark:border-white/10 dark:bg-white/5"/>
				</label>
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60 dark:text-zinc-400">@Tx("horizon")</span>
					<input type="number" inputmode="numeric" name="horizon" value="10" min="1" max="50" x-model="horizon" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 dark:border-white/10 dark:bg-white/5"/>
				</label>
				<fieldset class="text-sm">
					<legend class="mb-2 text-ink/60 dark:text-zinc-400">@Tx("risk")</legend>
					<div class="grid gap-2 sm:grid-cols-3">
						<label class="risk-card">
							<input type="radio" name="risk" value="conservative" class="sr-only"/>
							<span class="font-medium">@Tx("risk_con")</span>
							<span class="mt-0.5 block text-xs text-ink/50 dark:text-zinc-400">@Tx("risk_con_sub")</span>
						</label>
						<label class="risk-card">
							<input type="radio" name="risk" value="moderate" checked class="sr-only"/>
							<span class="font-medium">@Tx("risk_mod")</span>
							<span class="mt-0.5 block text-xs text-ink/50 dark:text-zinc-400">@Tx("risk_mod_sub")</span>
						</label>
						<label class="risk-card">
							<input type="radio" name="risk" value="aggressive" class="sr-only"/>
							<span class="font-medium">@Tx("risk_agg")</span>
							<span class="mt-0.5 block text-xs text-ink/50 dark:text-zinc-400">@Tx("risk_agg_sub")</span>
						</label>
					</div>
				</fieldset>
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60 dark:text-zinc-400">@Tx("monthly_inv")</span>
					<input type="text" inputmode="text" autocomplete="off" name="monthly_investable" value="25000" placeholder="50000 or 50k" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 dark:border-white/10 dark:bg-white/5"/>
				</label>
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60 dark:text-zinc-400">@Tx("goals")</span>
					<textarea name="goals" rows="4" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 dark:border-white/10 dark:bg-white/5" x-bind:placeholder="$store.lang.t('goals_ph')"></textarea>
				</label>
				<button type="submit" class="btn-primary w-full sm:w-auto">@Tx("show_mix")</button>
				<span id="guide-ind" class="htmx-indicator ml-2 text-sm text-ink/60 dark:text-zinc-400">@Tx("working")</span>
			</div>
			<div class="min-w-0 lg:col-span-7">
				<div id="guidance-result" class="rounded-2xl border border-dashed border-black/10 p-4 text-sm text-ink/50 sm:p-6 dark:border-white/15 dark:text-zinc-400">
					@Tx("guide_empty")
				</div>
			</div>
		</form>
	}
}

templ GuidanceResult(v GuidanceResultView) {
	<div class="rounded-2xl border border-black/5 bg-white/80 p-4 shadow-card sm:p-6 dark:border-white/10 dark:bg-white/5" data-donut-labels={ v.Labels } data-donut-values={ v.Values }>
		if v.Warning != "" {
			<p class="mb-4 rounded-xl bg-amber-50 px-3 py-2 text-sm text-amber-950 dark:bg-amber-950/40 dark:text-amber-100">{ v.Warning }</p>
		}
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h2 class="font-serif text-xl sm:text-2xl">@Tx("sleeves")</h2>
			<span class="rounded-full bg-black/5 px-3 py-1 text-xs dark:bg-white/10">{ v.Source }</span>
		</div>
		<div class="mx-auto mt-4 max-w-xs">
			<canvas id="guidance-donut"></canvas>
		</div>
		<ul class="mt-6 space-y-2 text-sm">
			for _, s := range v.Sleeves {
				<li class="flex justify-between gap-4 border-b border-black/5 py-2 dark:border-white/10">
					<span class="min-w-0">{ s.Category }</span>
					<span class="shrink-0 font-serif tabular-nums">{ s.Percent }%</span>
				</li>
			}
		</ul>
		<p class="mt-6 text-sm leading-relaxed text-ink/70 dark:text-zinc-300">{ v.Rationale }</p>
		<div class="mt-6 flex flex-wrap gap-2">
			<a href="/" class="btn-ghost">@Tx("jump_home")</a>
			<a href="/calculators/fire" class="btn-primary">@Tx("play_fire")</a>
		</div>
	</div>
}
