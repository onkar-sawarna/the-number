package templates

templ GuidancePage(p Page) {
	@Layout(p) {
		<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">A mix, not a stock tip</h1>
		<p class="mt-2 max-w-2xl text-sm text-ink/65 sm:text-base dark:text-zinc-400">Sleeves across index categories. Never a stock, fund, AMC, or ticker.</p>
		<form class="mt-6 grid min-w-0 gap-6 sm:mt-8 sm:gap-8 lg:grid-cols-12" hx-post="/guidance" hx-target="#guidance-result" hx-swap="innerHTML" hx-indicator="#guide-ind">
			<div class="min-w-0 space-y-5 lg:col-span-5">
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60 dark:text-zinc-400">Age</span>
					<input type="number" inputmode="numeric" name="age" value="30" min="18" max="90" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 dark:border-white/10 dark:bg-white/5"/>
				</label>
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60 dark:text-zinc-400">Horizon (years)</span>
					<input type="number" inputmode="numeric" name="horizon" value="10" min="1" max="50" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 dark:border-white/10 dark:bg-white/5"/>
				</label>
				<fieldset class="text-sm">
					<legend class="mb-2 text-ink/60 dark:text-zinc-400">Risk stance</legend>
					<div class="grid gap-2 sm:grid-cols-3">
						<label class="risk-card">
							<input type="radio" name="risk" value="conservative" class="sr-only"/>
							<span class="font-medium">Conservative</span>
							<span class="mt-0.5 block text-xs text-ink/50 dark:text-zinc-400">Sleep at night</span>
						</label>
						<label class="risk-card">
							<input type="radio" name="risk" value="moderate" checked class="sr-only"/>
							<span class="font-medium">Moderate</span>
							<span class="mt-0.5 block text-xs text-ink/50 dark:text-zinc-400">Balanced mix</span>
						</label>
						<label class="risk-card">
							<input type="radio" name="risk" value="aggressive" class="sr-only"/>
							<span class="font-medium">Aggressive</span>
							<span class="mt-0.5 block text-xs text-ink/50 dark:text-zinc-400">Long horizon</span>
						</label>
					</div>
				</fieldset>
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60 dark:text-zinc-400">Monthly investable</span>
					<input type="number" inputmode="decimal" name="monthly_investable" value="25000" min="0" step="500" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 dark:border-white/10 dark:bg-white/5"/>
				</label>
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60 dark:text-zinc-400">Goals</span>
					<textarea name="goals" rows="4" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 dark:border-white/10 dark:bg-white/5" placeholder="Independence, a home, children’s education — in your words."></textarea>
				</label>
				<button type="submit" class="btn-primary w-full sm:w-auto">Show my mix</button>
				<span id="guide-ind" class="htmx-indicator ml-2 text-sm text-ink/60">Working…</span>
			</div>
			<div class="min-w-0 lg:col-span-7">
				<div id="guidance-result" class="rounded-2xl border border-dashed border-black/10 p-4 text-sm text-ink/50 sm:p-6 dark:border-white/15">
					Submit to see a category mix. Calculators stay on-device; this is the one network call.
				</div>
			</div>
		</form>
	}
}

templ GuidanceResult(v GuidanceResultView) {
	<div class="rounded-2xl border border-black/5 bg-white/80 p-4 shadow-card sm:p-6 dark:border-white/10 dark:bg-white/5" data-donut-labels={ v.Labels } data-donut-values={ v.Values }>
		if v.Warning != "" {
			<p class="mb-4 rounded-xl bg-amber-50 px-3 py-2 text-sm text-amber-950 dark:bg-amber-950/40 dark:text-amber-100">{ v.Warning }</p>
		}
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h2 class="font-serif text-xl sm:text-2xl">Suggested sleeves</h2>
			<span class="rounded-full bg-black/5 px-3 py-1 text-xs dark:bg-white/10">{ v.Source }</span>
		</div>
		<div class="mx-auto mt-4 max-w-xs">
			<canvas id="guidance-donut"></canvas>
		</div>
		<ul class="mt-6 space-y-2 text-sm">
			for _, s := range v.Sleeves {
				<li class="flex justify-between gap-4 border-b border-black/5 py-2 dark:border-white/10">
					<span class="min-w-0">{ s.Category }</span>
					<span class="shrink-0 font-serif tabular-nums">{ s.Percent }%</span>
				</li>
			}
		</ul>
		<p class="mt-6 text-sm leading-relaxed text-ink/70 dark:text-zinc-300">{ v.Rationale }</p>
		<div class="mt-6 flex flex-wrap gap-2">
			<a href="/" class="btn-ghost">← Home</a>
			<a href="/calculators/fire" class="btn-primary">Play with FIRE</a>
		</div>
	</div>
}
