package templates

templ Login(v AuthView) {
	@Layout(v.Page) {
		<div class="mx-auto max-w-md rounded-2xl border border-black/5 bg-white/80 p-8 shadow-card dark:border-white/10 dark:bg-white/5">
			<h1 class="font-serif text-3xl">Log in</h1>
			<p class="mt-2 text-sm text-ink/60 dark:text-zinc-400">Save scenarios and compare them on your dashboard.</p>
			if v.Error != "" {
				<p class="mt-4 rounded-xl bg-red-50 px-3 py-2 text-sm text-red-800 dark:bg-red-950/40 dark:text-red-200">{ v.Error }</p>
			}
			<form method="post" action="/login" class="mt-6 space-y-4">
				if v.Next != "" {
					<input type="hidden" name="next" value={ v.Next }/>
				}
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60 dark:text-zinc-400">Email</span>
					<input type="email" name="email" value={ v.Value } required class="w-full rounded-xl border border-black/10 bg-white px-3 py-2 dark:border-white/10 dark:bg-white/5"/>
				</label>
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60 dark:text-zinc-400">Password</span>
					<input type="password" name="password" required minlength="8" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2 dark:border-white/10 dark:bg-white/5"/>
				</label>
				<button type="submit" class="w-full rounded-full bg-brand py-2.5 text-sm font-medium text-white">Log in</button>
			</form>
			<p class="mt-6 text-sm text-ink/60">No account? <a href="/signup" class="text-brand underline underline-offset-2">Sign up</a></p>
		</div>
	}
}

templ Signup(v AuthView) {
	@Layout(v.Page) {
		<div class="mx-auto max-w-md rounded-2xl border border-black/5 bg-white/80 p-8 shadow-card dark:border-white/10 dark:bg-white/5">
			<h1 class="font-serif text-3xl">Create a free account</h1>
			<p class="mt-2 text-sm text-ink/60 dark:text-zinc-400">Calculators stay free. An account lets you save.</p>
			if v.Error != "" {
				<p class="mt-4 rounded-xl bg-red-50 px-3 py-2 text-sm text-red-800 dark:bg-red-950/40 dark:text-red-200">{ v.Error }</p>
			}
			<form method="post" action="/signup" class="mt-6 space-y-4">
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60 dark:text-zinc-400">Email</span>
					<input type="email" name="email" value={ v.Value } required class="w-full rounded-xl border border-black/10 bg-white px-3 py-2 dark:border-white/10 dark:bg-white/5"/>
				</label>
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60 dark:text-zinc-400">Password (min 8)</span>
					<input type="password" name="password" required minlength="8" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2 dark:border-white/10 dark:bg-white/5"/>
				</label>
				<label class="block text-sm">
					<span class="mb-1 block text-ink/60 dark:text-zinc-400">Confirm password</span>
					<input type="password" name="confirm_password" required minlength="8" class="w-full rounded-xl border border-black/10 bg-white px-3 py-2 dark:border-white/10 dark:bg-white/5"/>
				</label>
				<button type="submit" class="w-full rounded-full bg-brand py-2.5 text-sm font-medium text-white">Create account</button>
			</form>
			<p class="mt-6 text-sm text-ink/60">Already have an account? <a href="/login" class="text-brand underline underline-offset-2">Log in</a></p>
		</div>
	}
}
