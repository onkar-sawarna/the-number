package templates

templ Landing(p Page) {
	@Layout(p) {
		<section class="relative overflow-hidden pb-2 sm:pb-4">
			<div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-brand/25 blur-3xl dark:bg-brand/40 md:h-80 md:w-80"></div>
			<div class="pointer-events-none absolute -left-20 top-32 h-40 w-40 rounded-full bg-sky/30 blur-3xl dark:bg-sky/20"></div>
			<p class="relative text-[11px] font-semibold uppercase tracking-[0.2em] text-brand sm:text-xs">@Tx("hero_kicker")</p>
			<h1 class="relative mt-3 max-w-full font-serif text-[1.85rem] leading-[1.15] tracking-tight sm:mt-4 sm:max-w-3xl sm:text-5xl lg:text-6xl">@Tx("hero_before")<em class="not-italic text-brand">the number</em>@Tx("hero_after")</h1>
			<p class="relative mt-4 max-w-2xl text-base leading-relaxed text-ink/70 sm:mt-6 sm:text-lg dark:text-zinc-300">@Tx("hero_sub")</p>
			<div class="relative mt-5 flex flex-wrap gap-2">
				<span class="rounded-full bg-brand/10 px-3 py-1 text-xs font-medium text-brand dark:bg-brand/20">@Tx("chip_product")</span>
				<span class="rounded-full bg-brand/10 px-3 py-1 text-xs font-medium text-brand dark:bg-brand/20">@Tx("chip_browser")</span>
				<span class="rounded-full bg-brand/10 px-3 py-1 text-xs font-medium text-brand dark:bg-brand/20">@Tx("chip_ticker")</span>
			</div>
			<div class="relative mt-6 sm:mt-8">
				<a href="#try-fire" class="btn-primary w-full sm:w-auto">@Tx("hero_cta")</a>
			</div>
			<p class="currency-in pointer-events-none absolute -right-6 top-8 hidden select-none font-serif text-[10rem] leading-none text-brand/10 md:block">₹</p>
			<p class="currency-us pointer-events-none absolute -right-6 top-8 hidden select-none font-serif text-[10rem] leading-none text-brand/10 md:block">$</p>
		</section>
		<section id="try-fire" class="relative mt-8 scroll-mt-28 sm:mt-12" x-data="fireCalc()">
			<form class="min-w-0 overflow-hidden rounded-3xl border border-brand/20 bg-white/80 p-5 shadow-card sm:p-8 dark:border-brand/30 dark:bg-white/5" x-on:input="markDirty()" x-on:submit.prevent>
				<div class="grid min-w-0 gap-8 lg:grid-cols-12 lg:items-center">
					<div class="min-w-0 lg:col-span-5">
						<div class="flex items-start justify-between gap-3">
							<p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-brand">@Tx("try_kicker")</p>
							@RegionToggle()
						</div>
						<p class="mt-2 font-serif text-3xl tracking-tight sm:text-4xl" x-show="!revealed" x-cloak>@Tx("calc_wait_hook")</p>
						<p class="mt-2 font-serif text-4xl tabular-nums tracking-tight sm:text-5xl" x-show="revealed" x-cloak x-bind:class="dirty ? 'opacity-50' : ''" x-text="hookLine()"></p>
						<p class="mt-2 text-sm text-ink/60 dark:text-zinc-400" x-show="revealed" x-cloak x-bind:class="dirty ? 'opacity-50' : ''" x-text="hookSub()"></p>
						<div class="mt-4 flex flex-wrap gap-2">
							<button type="button" class="preset-chip" x-on:click="applyPreset('start')">@Tx("preset_start")</button>
							<button type="button" class="preset-chip" x-on:click="applyPreset('mid')">@Tx("preset_mid")</button>
							<button type="button" class="preset-chip" x-on:click="applyPreset('ahead')">@Tx("preset_ahead")</button>
						</div>
					</div>
					<div class="min-w-0 space-y-5 lg:col-span-7">
						@labeledRange("age_home", "age_yours", "age", "18", "70", "1")
						@playRange("monthly_sips", "monthlySavings", true)
						@labeledRange("step_up_home", "step_up", "stepUp", "0", "20", "1")
						@playRange("annual_spend", "annualExpenses", true)
						@playRange("parked_cash", "currentSavings", true)
						@calcButton()
					</div>
				</div>
				<div class="mt-8 scroll-mt-28 border-t border-brand/15 pt-6">
					<div class="rounded-2xl border border-black/10 bg-white p-4 shadow-card sm:p-6 dark:border-white/25 dark:bg-zinc-950" x-show="!revealed" x-cloak>
						@calcWaitBody()
					</div>
					<div id="calc-result" x-show="revealed" x-cloak>
						<div class="rounded-2xl border border-black/10 bg-white p-4 shadow-card sm:p-6 dark:border-white/25 dark:bg-zinc-950" x-bind:class="dirty ? 'opacity-50' : ''">
							<p class="text-xs font-semibold uppercase tracking-widest text-ink/65 dark:text-zinc-300">@Tx("number_today")</p>
							<p class="mt-1 font-serif text-3xl tabular-nums tracking-tight sm:text-4xl" x-text="fmtINR(result.fireNumber)"></p>
							<p class="mt-1 text-sm text-ink/70 dark:text-zinc-300" x-text="yearsCopy()"></p>
							<p class="mt-0.5 text-sm font-medium text-ink dark:text-zinc-100" x-text="numberLaterCopy()"></p>
							<div class="mt-4 grid grid-cols-2 gap-2 text-sm sm:grid-cols-4 sm:gap-3">
								<div class="rounded-xl bg-paper p-2.5 dark:bg-zinc-800">
									<p class="text-xs text-ink/70 dark:text-zinc-300">@Tx("lifestyle")</p>
									<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.lifestyle)"></p>
									<p class="mt-1 text-[11px] text-ink/65 dark:text-zinc-300">@Tx("later_20")<span class="tabular-nums" x-text="fmtINR(result.lifestyleLater)"></span></p>
								</div>
								<div class="rounded-xl bg-paper p-2.5 dark:bg-zinc-800">
									<p class="text-xs text-ink/70 dark:text-zinc-300">@Tx("you_have")</p>
									<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.startingCorpus)"></p>
								</div>
								<div class="rounded-xl bg-paper p-2.5 dark:bg-zinc-800">
									<p class="text-xs text-ink/70 dark:text-zinc-300">@Tx("monthly_in")</p>
									<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.monthlyIn)"></p>
								</div>
								<div class="rounded-xl bg-paper p-2.5 dark:bg-zinc-800">
									<p class="text-xs text-ink/70 dark:text-zinc-300">@Tx("youll_be")</p>
									<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="result.reachesFire ? result.fiAge : '—'"></p>
								</div>
							</div>
							<div class="mt-4 h-40 min-w-0 overflow-hidden rounded-xl bg-paper sm:h-56 dark:bg-zinc-900">
								<canvas id="fire-chart"></canvas>
							</div>
						</div>
					</div>
					<div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
						<div class="min-w-0">
							<p class="text-sm font-medium text-ink dark:text-zinc-100">@Tx("want_detail")</p>
							<p class="mt-1 text-sm leading-relaxed text-ink/65 dark:text-zinc-400" x-show="isIN()">@Tx("want_detail_in")</p>
							<p class="mt-1 text-sm leading-relaxed text-ink/65 dark:text-zinc-400" x-show="isUS()" x-cloak>@Tx("want_detail_us")</p>
						</div>
						<a href="/calculators/fire" class="btn-primary w-full shrink-0 sm:w-auto">@Tx("open_full")</a>
					</div>
				</div>
			</form>
		</section>
		<nav class="mt-8 border-t border-black/5 pt-6 sm:mt-10 dark:border-white/10" aria-label="Other calculators">
			<p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-ink/45 dark:text-zinc-500">@Tx("more_calcs_kicker")</p>
			<p class="mt-1 text-sm text-ink/60 dark:text-zinc-400">@Tx("more_calcs_lead")</p>
			<div class="mt-3 flex flex-wrap gap-2">
				<a href="/calculators/sip" class="preset-chip inline-flex items-center">@Tx("tab_sip")</a>
				<a href="/calculators/emi" class="preset-chip inline-flex items-center">@Tx("tab_emi")</a>
				<a href="/calculators/emergency" class="preset-chip inline-flex items-center">@Tx("tab_emergency")</a>
				<a href="/calculators/budget" class="preset-chip inline-flex items-center">@Tx("tab_budget")</a>
				<a href="/guidance" class="preset-chip inline-flex items-center">@Tx("tab_sleeves")</a>
			</div>
		</nav>
		<section class="mt-10 overflow-hidden rounded-3xl border border-brand/20 bg-white/80 p-5 shadow-card sm:mt-12 sm:p-8 dark:border-brand/30 dark:bg-white/5" aria-labelledby="about-maker">
			<p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-brand sm:text-xs">@Tx("home_about_kicker")</p>
			<div class="mt-3 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
				<div class="max-w-2xl">
					<h2 id="about-maker" class="font-serif text-2xl tracking-tight sm:text-3xl">Onkar Sawarna</h2>
					<p class="mt-3 text-base leading-relaxed text-ink/70 dark:text-zinc-300">@Tx("home_about_body")</p>
				</div>
				<div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row">
					<a href="/about" class="btn-primary w-full sm:w-auto">@Tx("home_about_page")</a>
					<a href="https://www.onkarsawarna.dev/" class="btn-ghost w-full sm:w-auto" rel="noopener noreferrer">@Tx("visit_blog")</a>
				</div>
			</div>
		</section>
	}
}

templ potMoneyRows() {
	<ul class="mt-2 space-y-1 text-sm">
		<template x-for="row in potRows()" x-bind:key="row.name">
			<li class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5 text-zinc-700 dark:text-zinc-100">
				<span class="font-medium" x-text="row.name"></span>
				<span class="tabular-nums text-zinc-600 dark:text-zinc-200" x-text="row.line"></span>
			</li>
		</template>
	</ul>
}

templ playRange(labelKey, model string, money bool) {
	<label class="block">
		<span class="mb-1 flex items-center justify-between gap-3 text-sm text-ink/60 dark:text-zinc-400">
			<span class="min-w-0">@Tx(labelKey)</span>
			if money {
				<span class="shrink-0 font-serif text-base tabular-nums text-ink dark:text-zinc-100" x-text={ "fmtINR(" + model + ")" }></span>
			} else {
				<span class="shrink-0 font-serif text-base tabular-nums text-ink dark:text-zinc-100" x-text={ model }></span>
			}
		</span>
		if money {
			@moneyText("", model)
		} else {
			<input type="number" inputmode="decimal" x-model.number={ model } x-bind:min={ "rangeMin('" + model + "')" } x-bind:max={ "rangeMax('" + model + "')" } x-bind:step={ "rangeStep('" + model + "')" } x-on:blur="recalc()" x-on:keydown.enter.prevent="$event.target.blur()" class="mt-1 w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 tabular-nums dark:border-white/10 dark:bg-white/5"/>
		}
	</label>
}

templ calcButton() {
	<div>
		<button type="button" class="btn-primary w-full sm:w-auto" x-bind:class="dirty ? '' : 'opacity-80'" x-on:click="recalc(true)">@Tx("calculate")</button>
		<p class="mt-1.5 text-xs font-medium text-brand" x-show="dirty" x-cloak>@Tx("dirty_hint")</p>
	</div>
}

templ deskColCalc() {
	@calcButton()
}

templ calcWaitBody() {
	<p class="text-xs font-semibold uppercase tracking-widest text-brand">@Tx("calc_wait_kicker")</p>
	<p class="mt-2 font-serif text-2xl tracking-tight sm:text-3xl">@Tx("calc_wait")</p>
	<ul class="mt-4 space-y-2 text-sm text-ink/70 dark:text-zinc-300">
		<li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span><span>@Tx("calc_wait_1")</span></li>
		<li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span><span>@Tx("calc_wait_2")</span></li>
		<li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span><span>@Tx("calc_wait_3")</span></li>
	</ul>
	<div class="mt-5 overflow-hidden rounded-xl bg-paper px-2 pt-5 dark:bg-zinc-900">
		<svg viewBox="0 0 360 150" class="h-36 w-full text-brand sm:h-48 dark:text-sky" fill="none" aria-hidden="true">
			<path d="M8 118 C 48 108, 72 72, 108 78 S 168 128, 210 96 S 282 36, 352 48 L 352 142 L 8 142 Z" fill="currentColor" fill-opacity="0.16"></path>
			<path d="M8 118 C 48 108, 72 72, 108 78 S 168 128, 210 96 S 282 36, 352 48" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
			<path d="M8 92 C 80 86, 150 80, 220 74 S 300 64, 352 58" stroke="currentColor" stroke-width="1.8" stroke-dasharray="6 5" stroke-opacity="0.7"></path>
			<rect x="28" y="104" width="18" height="28" rx="3" fill="currentColor" fill-opacity="0.28"></rect>
			<rect x="28" y="88" width="18" height="16" rx="3" fill="currentColor" fill-opacity="0.55"></rect>
			<rect x="58" y="96" width="18" height="36" rx="3" fill="currentColor" fill-opacity="0.28"></rect>
			<rect x="58" y="70" width="18" height="26" rx="3" fill="currentColor" fill-opacity="0.55"></rect>
			<rect x="88" y="100" width="18" height="32" rx="3" fill="currentColor" fill-opacity="0.28"></rect>
			<rect x="88" y="78" width="18" height="22" rx="3" fill="currentColor" fill-opacity="0.55"></rect>
		</svg>
	</div>
}

templ calcWait() {
	<div class="scroll-mt-28 rounded-2xl border border-black/10 bg-white p-4 shadow-card sm:p-6 dark:border-white/25 dark:bg-zinc-950 lg:sticky lg:top-[calc(var(--app-header-h,5.5rem)+1rem)]" x-show="!revealed" x-cloak>
		@calcWaitBody()
	</div>
}

templ featureCard(href, kicker, titleKey, bodyKey string, wide bool) {
	<a href={ templ.SafeURL(href) } class={ "hover-lift group rounded-2xl border border-black/5 bg-white/80 p-5 shadow-card sm:p-6 dark:border-white/10 dark:bg-white/5", templ.KV("sm:col-span-2", wide) }>
		<p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-brand">{ kicker }</p>
		<h2 class="mt-2 font-serif text-lg sm:text-xl">@Tx(titleKey)</h2>
		<p class="mt-2 text-sm leading-relaxed text-ink/65 dark:text-zinc-400">@Tx(bodyKey)</p>
		<p class="mt-3 text-sm font-medium text-brand opacity-80 group-hover:opacity-100">@Tx("open")</p>
	</a>
}

templ About(p Page) {
	@Layout(p) {
		<article class="mx-auto max-w-3xl">
			<p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-brand sm:text-xs">@Tx("about_kicker")</p>
			<header class="mt-5 flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8">
				<div class="about-portrait-wrap shrink-0">
					<img class="about-portrait-img" src="/static/img/onkar-352.jpg" srcset="/static/img/onkar-176.jpg 176w, /static/img/onkar-352.jpg 352w" sizes="(max-width: 40rem) 8.5rem, 11rem" width="220" height="220" alt="Onkar Sawarna"/>
				</div>
				<div class="min-w-0">
					<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">Onkar Sawarna</h1>
					<p class="mt-2 text-sm font-medium text-brand">@Tx("about_role")</p>
					<p class="mt-3 max-w-xl font-serif text-xl leading-snug text-ink/80 dark:text-zinc-200">@Tx("about_lede")</p>
					<div class="mt-5">
						@SocialLinks()
					</div>
				</div>
			</header>
			<p class="mt-8 text-lg leading-relaxed text-ink/80 dark:text-zinc-200">@Tx("about_lead")</p>
			<div class="mt-8 space-y-8 rounded-3xl border border-brand/20 bg-white/80 p-5 shadow-card sm:p-8 dark:border-brand/30 dark:bg-white/5">
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("about_h_money")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("about_p_money")</p>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("about_p_money2")</p>
				</section>
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("about_h_compound")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("about_p_compound")</p>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("about_p_compound2")</p>
				</section>
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("about_h_optional")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("about_p_optional")</p>
				</section>
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("about_h_number")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("about_p_number")</p>
				</section>
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("about_h_work")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("about_p_work")</p>
				</section>
				<div class="flex flex-col gap-2 pt-2 sm:flex-row sm:flex-wrap">
					<a href="/calculators/fire" class="btn-primary w-full sm:w-auto">@Tx("jump_fire")</a>
					<a href="https://www.onkarsawarna.dev/" class="btn-ghost w-full sm:w-auto" rel="noopener noreferrer">@Tx("visit_blog")</a>
				</div>
			</div>
		</article>
	}
}

templ Disclaimer(p Page) {
	@Layout(p) {
		<article class="prose-disclaimer mx-auto max-w-2xl">
			<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">@Tx("disc_h1")</h1>
			<p class="mt-6 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("disc_p1")</p>
			<h2 class="mt-10 font-serif text-2xl">@Tx("disc_h2")</h2>
			<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("disc_p2")</p>
			<h2 class="mt-10 font-serif text-2xl">@Tx("disc_h3")</h2>
			<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("disc_p3")</p>
			<h2 class="mt-10 font-serif text-2xl">@Tx("disc_h4")</h2>
			<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("disc_p4")</p>
			<h2 class="mt-10 font-serif text-2xl">@Tx("disc_h5")</h2>
			<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("disc_p5")</p>
			<p class="mt-8 text-sm text-ink/60 dark:text-zinc-400">Not registered investment advice. For educational purposes only.</p>
		</article>
	}
}
