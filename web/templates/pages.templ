package templates

templ Landing(p Page) {
	@Layout(p) {
		<section class="relative pb-1 sm:pb-4">
			<div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-brand/25 blur-3xl dark:bg-brand/40 md:h-80 md:w-80"></div>
			<div class="pointer-events-none absolute -left-20 top-32 h-40 w-40 rounded-full bg-sky/30 blur-3xl dark:bg-sky/20"></div>
			<p class="relative hidden text-[11px] font-semibold uppercase tracking-[0.2em] text-brand sm:block sm:text-xs">@Tx("hero_kicker")</p>
			<h1 class="relative mt-0 max-w-full break-words font-serif text-[1.55rem] leading-[1.15] tracking-tight sm:mt-4 sm:max-w-3xl sm:text-5xl lg:text-6xl">@Tx("hero_before")<em class="not-italic text-brand">the number</em>@Tx("hero_after")</h1>
			<p class="relative mt-2 max-w-2xl text-sm leading-snug text-ink/70 sm:hidden dark:text-zinc-300">@Tx("hero_sub_short")</p>
			<p class="relative mt-6 hidden max-w-2xl text-lg leading-relaxed text-ink/70 sm:block dark:text-zinc-300">@Tx("hero_sub")</p>
			<div class="relative mt-5 hidden flex-wrap gap-2 sm:flex">
				<span class="rounded-full bg-brand/10 px-3 py-1 text-xs font-medium text-brand dark:bg-brand/20">@Tx("chip_product")</span>
				<span class="rounded-full bg-brand/10 px-3 py-1 text-xs font-medium text-brand dark:bg-brand/20">@Tx("chip_browser")</span>
				<span class="rounded-full bg-brand/10 px-3 py-1 text-xs font-medium text-brand dark:bg-brand/20">@Tx("chip_ticker")</span>
			</div>
			<div class="relative mt-8 hidden sm:block">
				<a href="#try-fire" class="btn-primary w-auto">@Tx("hero_cta")</a>
			</div>
			<p class="currency-in pointer-events-none absolute -right-6 top-8 hidden select-none font-serif text-[10rem] leading-none text-brand/10 md:block">₹</p>
			<p class="currency-us pointer-events-none absolute -right-6 top-8 hidden select-none font-serif text-[10rem] leading-none text-brand/10 md:block">$</p>
		</section>
		<section id="try-fire" class="relative mt-4 scroll-mt-24 sm:mt-12" x-data="fireCalc()">
			<form class="min-w-0 overflow-hidden rounded-3xl border border-brand/20 bg-white/80 p-4 shadow-card sm:p-8 dark:border-brand/30 dark:bg-white/5" x-on:input="markDirty()" x-on:submit.prevent>
				<div class="grid min-w-0 gap-5 lg:grid-cols-12 lg:items-center lg:gap-8">
					<div class="min-w-0 lg:col-span-5">
						<div class="flex flex-col items-start gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-3">
							<p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-brand">@Tx("try_kicker")</p>
							@RegionToggle()
						</div>
						<p class="mt-2 font-serif text-xl tracking-tight sm:text-4xl" x-show="!revealed && !working" x-cloak>@Tx("calc_wait_hook")</p>
						<p class="mt-2 font-serif text-xl tracking-tight sm:text-4xl" x-show="working && !revealed" x-cloak>@Tx("calculate_busy")</p>
						<p class="mt-2 font-serif text-2xl tabular-nums tracking-tight sm:text-5xl" x-show="revealed" x-cloak x-bind:class="dirty ? 'opacity-50' : ''" x-text="hookLine()"></p>
						<p class="mt-2 text-sm text-ink/60 dark:text-zinc-400" x-show="revealed" x-cloak x-bind:class="dirty ? 'opacity-50' : ''" x-text="hookSub()"></p>
						<div class="mt-4 flex flex-wrap gap-2">
							<button type="button" class="preset-chip" x-on:click="applyPreset('start')">@Tx("preset_start")</button>
							<button type="button" class="preset-chip" x-on:click="applyPreset('mid')">@Tx("preset_mid")</button>
							<button type="button" class="preset-chip" x-on:click="applyPreset('ahead')">@Tx("preset_ahead")</button>
						</div>
					</div>
					<div class="min-w-0 space-y-3 sm:space-y-5 lg:col-span-7">
						@labeledRange("age_home", "age_yours", "age", "18", "70", "1")
						@playRange("monthly_sips", "monthlySavings", true)
						@labeledRange("step_up_home", "step_up", "stepUp", "0", "20", "1")
						@playRange("annual_spend", "annualExpenses", true)
						@playRange("parked_cash", "currentSavings", true)
						@calcButton()
					</div>
				</div>
				<div class="mt-8 scroll-mt-28 border-t border-brand/15 pt-6">
					<div class="rounded-2xl border border-black/10 bg-white p-4 shadow-card sm:p-6 dark:border-white/25 dark:bg-zinc-950" x-show="!revealed" x-cloak>
						@calcWaitBody()
					</div>
					<div id="calc-result" x-show="revealed" x-cloak x-bind:class="resultRevealClass()">
						<div class="rounded-2xl border border-black/10 bg-white p-4 shadow-card sm:p-6 dark:border-white/25 dark:bg-zinc-950" x-bind:class="dirty ? 'opacity-50' : ''">
							<div class="result-hero">
								<p class="result-kicker">@Tx("number_today")</p>
								<p class="result-num mt-1 text-3xl sm:text-4xl" x-text="fmtINR(result.stillNeed)"></p>
								<p class="result-line-gap mt-2" x-text="stillNeedCopy()"></p>
								<p class="result-line-fi mt-1" x-text="yearsCopy()"></p>
								<p class="result-line-cross mt-0.5" x-text="crossingCopy()"></p>
								<p class="result-line-coast mt-0.5" x-show="coastLine()" x-cloak x-text="coastLine()"></p>
								<p class="result-line-later mt-0.5" x-text="numberLaterCopy()"></p>
							</div>
							<div class="mt-4 grid grid-cols-2 gap-2 text-sm sm:grid-cols-4 sm:gap-3">
								<div class="result-tile result-tile-need">
									<p>@Tx("lifestyle")</p>
									<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.lifestyle)"></p>
									<p class="mt-1 text-[11px] opacity-75">@Tx("later_20")<span class="tabular-nums" x-text="fmtINR(result.lifestyleLater)"></span></p>
								</div>
								<div class="result-tile result-tile-have">
									<p>@Tx("you_have")</p>
									<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.spendableNow)"></p>
								</div>
								<div class="result-tile result-tile-sip">
									<p>@Tx("monthly_in")</p>
									<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="fmtINR(result.monthlyIn)"></p>
								</div>
								<div class="result-tile result-tile-age">
									<p>@Tx("youll_be")</p>
									<p class="font-serif text-sm tabular-nums sm:text-lg" x-text="result.reachesFire ? result.fiAge : '—'"></p>
								</div>
							</div>
							@fireChartIntro()
							<div class="fire-chart-box mt-3 min-w-0 overflow-hidden rounded-xl bg-paper dark:bg-zinc-900">
								<canvas id="fire-chart"></canvas>
							</div>
							@fireChartLegend()
							@fireResultExtras(false)
							<div class="mt-5 flex flex-col gap-3 border-t border-black/5 pt-5 sm:flex-row sm:items-center sm:justify-between dark:border-white/10">
								<div class="min-w-0">
									<p class="text-sm font-medium text-ink dark:text-zinc-100">@Tx("want_detail")</p>
									<p class="mt-1 text-sm leading-relaxed text-ink/65 dark:text-zinc-400" x-show="isIN()">@Tx("want_detail_in")</p>
									<p class="mt-1 text-sm leading-relaxed text-ink/65 dark:text-zinc-400" x-show="isUS()" x-cloak>@Tx("want_detail_us")</p>
								</div>
								<a href="/calculators/fire" class="btn-primary w-full shrink-0 sm:w-auto" x-bind:href="fullFireHref()">@Tx("open_full")</a>
							</div>
						</div>
					</div>
				</div>
			</form>
		</section>
		<nav class="mt-8 border-t border-black/5 pt-6 sm:mt-10 dark:border-white/10" aria-label="Other calculators">
			<p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-ink/45 dark:text-zinc-500">@Tx("more_calcs_kicker")</p>
			<p class="mt-1 text-sm text-ink/60 dark:text-zinc-400">@Tx("more_calcs_lead")</p>
			<div class="mt-3 flex flex-wrap gap-2">
				<a href="/calculators/sip" class="preset-chip inline-flex items-center">@Tx("tab_sip")</a>
				<a href="/calculators/emi" class="preset-chip inline-flex items-center">@Tx("tab_emi")</a>
				<a href="/calculators/emergency" class="preset-chip inline-flex items-center">@Tx("tab_emergency")</a>
				<a href="/calculators/budget" class="preset-chip inline-flex items-center">@Tx("tab_budget")</a>
				<a href="/crossing" class="preset-chip inline-flex items-center">@Tx("jump_crossing")</a>
			</div>
		</nav>
		<section class="mt-10 overflow-hidden rounded-3xl border border-brand/20 bg-white/80 p-5 shadow-card sm:mt-12 sm:p-8 dark:border-brand/30 dark:bg-white/5" aria-labelledby="about-maker">
			<p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-brand sm:text-xs">@Tx("home_about_kicker")</p>
			<div class="mt-4 flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-6">
				<div class="about-portrait-wrap is-teaser shrink-0">
					<img class="about-portrait-img" src="/static/img/onkar-176.jpg" srcset="/static/img/onkar-176.jpg 176w, /static/img/onkar-352.jpg 352w" sizes="5.75rem" width="92" height="92" alt="Onkar Sawarna"/>
				</div>
				<div class="min-w-0 flex-1">
					<h2 id="about-maker" class="font-serif text-2xl tracking-tight sm:text-3xl">Onkar Sawarna</h2>
					<p class="mt-1 text-sm font-medium text-brand">@Tx("about_role")</p>
					<p class="mt-3 max-w-2xl text-base leading-relaxed text-ink/70 dark:text-zinc-300">@Tx("home_about_body")</p>
				</div>
				<a href="/about" class="btn-primary w-full shrink-0 sm:w-auto">@Tx("home_about_page")</a>
			</div>
		</section>
	}
}

templ fireChartIntro() {
	<p class="mt-5 text-xs font-semibold uppercase tracking-widest text-ink/65 dark:text-zinc-300" x-bind:class="dirty ? 'opacity-50' : ''">@Tx("chart_stack")</p>
	<p class="mt-1 text-sm text-ink/65 dark:text-zinc-400" x-bind:class="dirty ? 'opacity-50' : ''">@Tx("chart_stack_sub")</p>
}

templ fireChartLegend() {
	<ul class="mt-3 space-y-2.5" x-bind:class="dirty ? 'opacity-50' : ''">
		<template x-for="row in fireStoryLegend()" x-bind:key="row.key">
			<li class="flex gap-2.5">
				<span class="legend-swatch" x-bind:class="row.cls" x-bind:style="row.swatch"></span>
				<div class="min-w-0">
					<p class="text-sm font-medium text-ink dark:text-zinc-100" x-text="row.label"></p>
					<p class="mt-0.5 text-xs leading-snug text-ink/60 dark:text-zinc-400" x-text="row.hint"></p>
				</div>
			</li>
		</template>
	</ul>
	<ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1.5 text-[11px] leading-snug text-ink/70 dark:text-zinc-300" x-show="firePotLegend().length" x-cloak x-bind:class="dirty ? 'opacity-50' : ''">
		<template x-for="row in firePotLegend()" x-bind:key="row.label">
			<li class="inline-flex items-center gap-1.5">
				<span class="legend-swatch legend-swatch-fill" x-bind:style="row.swatch"></span>
				<span x-text="row.label"></span>
			</li>
		</template>
	</ul>
}

templ potMoneyRows() {
	<ul class="mt-2 space-y-1 text-sm">
		<template x-for="row in potRows()" x-bind:key="row.name">
			<li class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5 text-zinc-700 dark:text-zinc-100">
				<span class="font-medium" x-text="row.name"></span>
				<span class="tabular-nums text-zinc-600 dark:text-zinc-200" x-text="row.line"></span>
			</li>
		</template>
	</ul>
}

templ playRange(labelKey, model string, money bool) {
	<label class="block">
		<span class="mb-1 flex items-center justify-between gap-3 text-sm text-ink/60 dark:text-zinc-400">
			<span class="min-w-0">@Tx(labelKey)</span>
			if money {
				<span class="shrink-0 font-serif text-base tabular-nums text-ink dark:text-zinc-100" x-text={ "fmtINR(" + model + ")" }></span>
			} else {
				<span class="shrink-0 font-serif text-base tabular-nums text-ink dark:text-zinc-100" x-text={ model }></span>
			}
		</span>
		if money {
			@moneyText("", model)
		} else {
			<input type="number" inputmode="decimal" x-model.number={ model } x-bind:min={ "rangeMin('" + model + "')" } x-bind:max={ "rangeMax('" + model + "')" } x-bind:step={ "rangeStep('" + model + "')" } x-on:blur="recalc()" x-on:keydown.enter.prevent="$event.target.blur()" class="mt-1 w-full rounded-xl border border-black/10 bg-white px-3 py-2.5 tabular-nums dark:border-white/10 dark:bg-white/5"/>
		}
	</label>
}

templ calcButton() {
	<div>
		<button type="button" class="btn-primary w-full sm:w-auto" x-bind:disabled="working" x-bind:aria-busy="working" x-bind:class="working || dirty ? '' : 'opacity-80'" x-on:click="recalc(true)">
			<span class="inline-flex items-center justify-center gap-2">
				<span class="calc-spin" x-show="working" x-cloak aria-hidden="true"></span>
				<span x-show="!working">@Tx("calculate")</span>
				<span x-show="working" x-cloak>@Tx("calculate_working")</span>
			</span>
		</button>
		<p class="mt-1.5 text-xs font-medium text-brand" x-show="working" x-cloak>@Tx("calculate_busy")</p>
		<p class="mt-1.5 text-xs font-medium text-brand" x-show="dirty && !working" x-cloak>@Tx("dirty_hint")</p>
	</div>
}

templ deskColCalc() {
	@calcButton()
}

templ calcWaitBody() {
	<p class="text-xs font-semibold uppercase tracking-widest text-brand">@Tx("calc_wait_kicker")</p>
	<p class="mt-2 font-serif text-xl tracking-tight sm:text-3xl">@Tx("calc_wait")</p>
	<ul class="mt-4 hidden space-y-2 text-sm text-ink/70 sm:block dark:text-zinc-300">
		<li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span><span>@Tx("calc_wait_1")</span></li>
		<li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span><span>@Tx("calc_wait_2")</span></li>
		<li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span><span>@Tx("calc_wait_3")</span></li>
		<li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span><span>@Tx("calc_wait_4")</span></li>
	</ul>
	<div class="calc-progress mt-5" x-show="working" x-cloak>
		<div class="calc-progress-bar"></div>
	</div>
	<div class="mt-4 overflow-hidden rounded-xl bg-paper px-2 pt-4 dark:bg-zinc-900 sm:mt-5 sm:pt-5" x-bind:class="working ? 'calc-chart-busy' : ''">
		<svg viewBox="0 0 360 150" class="h-24 w-full text-brand sm:h-48 dark:text-sky" fill="none" aria-hidden="true">
			<path d="M8 118 C 48 108, 72 72, 108 78 S 168 128, 210 96 S 282 36, 352 48 L 352 142 L 8 142 Z" fill="currentColor" fill-opacity="0.16"></path>
			<path d="M8 118 C 48 108, 72 72, 108 78 S 168 128, 210 96 S 282 36, 352 48" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
			<path d="M8 92 C 80 86, 150 80, 220 74 S 300 64, 352 58" stroke="currentColor" stroke-width="1.8" stroke-dasharray="6 5" stroke-opacity="0.7"></path>
			<rect x="28" y="104" width="18" height="28" rx="3" fill="currentColor" fill-opacity="0.28"></rect>
			<rect x="28" y="88" width="18" height="16" rx="3" fill="currentColor" fill-opacity="0.55"></rect>
			<rect x="58" y="96" width="18" height="36" rx="3" fill="currentColor" fill-opacity="0.28"></rect>
			<rect x="58" y="70" width="18" height="26" rx="3" fill="currentColor" fill-opacity="0.55"></rect>
			<rect x="88" y="100" width="18" height="32" rx="3" fill="currentColor" fill-opacity="0.28"></rect>
			<rect x="88" y="78" width="18" height="22" rx="3" fill="currentColor" fill-opacity="0.55"></rect>
		</svg>
	</div>
}

templ calcWait() {
	<div class="scroll-mt-28 rounded-2xl border border-black/10 bg-white p-4 shadow-card sm:p-6 dark:border-white/25 dark:bg-zinc-950 lg:sticky lg:top-[calc(var(--app-header-h,5.5rem)+1rem)]" x-show="!revealed" x-cloak>
		@calcWaitBody()
	</div>
}

templ featureCard(href, kicker, titleKey, bodyKey string, wide bool) {
	<a href={ templ.SafeURL(href) } class={ "hover-lift group rounded-2xl border border-black/5 bg-white/80 p-5 shadow-card sm:p-6 dark:border-white/10 dark:bg-white/5", templ.KV("sm:col-span-2", wide) }>
		<p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-brand">{ kicker }</p>
		<h2 class="mt-2 font-serif text-lg sm:text-xl">@Tx(titleKey)</h2>
		<p class="mt-2 text-sm leading-relaxed text-ink/65 dark:text-zinc-400">@Tx(bodyKey)</p>
		<p class="mt-3 text-sm font-medium text-brand opacity-80 group-hover:opacity-100">@Tx("open")</p>
	</a>
}

templ About(p Page) {
	@Layout(p) {
		<article class="mx-auto max-w-3xl">
			<p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-brand sm:text-xs">@Tx("about_kicker")</p>
			<header class="mt-5 flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8">
				<div class="about-portrait-wrap shrink-0">
					<img class="about-portrait-img" src="/static/img/onkar-352.jpg" srcset="/static/img/onkar-176.jpg 176w, /static/img/onkar-352.jpg 352w" sizes="(max-width: 40rem) 8.5rem, 11rem" width="220" height="220" alt="Onkar Sawarna"/>
				</div>
				<div class="min-w-0">
					<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">Onkar Sawarna</h1>
					<p class="mt-2 text-sm font-medium text-brand">@Tx("about_role")</p>
					<p class="mt-3 max-w-xl font-serif text-xl leading-snug text-ink/80 dark:text-zinc-200">@Tx("about_lede")</p>
					<div class="mt-5">
						@SocialLinks()
					</div>
				</div>
			</header>
			<div class="mt-10 space-y-8 rounded-3xl border border-brand/20 bg-white/80 p-5 shadow-card sm:p-8 dark:border-brand/30 dark:bg-white/5">
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("about_h_money")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("about_p_money")</p>
				</section>
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("about_h_compound")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("about_p_compound")</p>
					<p class="mt-3"><a href="/crossing" class="font-medium text-brand hover:underline">@Tx("crossing_learn")</a></p>
				</section>
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("about_h_number")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("about_p_number")</p>
				</section>
				<div class="flex flex-col gap-2 pt-2 sm:flex-row sm:flex-wrap">
					<a href="/calculators/fire" class="btn-primary w-full sm:w-auto">@Tx("jump_fire")</a>
					<a href="/crossing" class="btn-ghost w-full sm:w-auto">@Tx("jump_crossing")</a>
					<a href="/support" class="btn-ghost w-full sm:w-auto">@Tx("jump_support")</a>
					<a href="https://www.onkarsawarna.dev/" class="btn-ghost w-full sm:w-auto" rel="noopener noreferrer">@Tx("visit_blog")</a>
				</div>
			</div>
		</article>
	}
}

templ fireResultExtras(withSupport bool) {
	<div class="mt-5 space-y-3 border-t border-black/5 pt-5 dark:border-white/10" x-bind:class="dirty ? 'opacity-50' : ''">
		<div class="result-panel-moves">
			<p class="result-kicker">@Tx("moves_kicker")</p>
			<ul class="mt-2 space-y-1.5">
				<template x-for="row in moveRows()" x-bind:key="row.kind">
					<li x-bind:class="row.cls" x-text="row.line"></li>
				</template>
			</ul>
		</div>
		<div class="result-panel-optional">
			<p class="result-kicker">@Tx("optional_kicker")</p>
			<p class="mt-1 text-sm text-ink/60 dark:text-zinc-400">@Tx("optional_sub")</p>
			<ul class="mt-2 space-y-1.5">
				<template x-for="row in optionRows()" x-bind:key="row.kind">
					<li class="result-option" x-text="row.line"></li>
				</template>
			</ul>
		</div>
		<div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
			<button type="button" class="btn-ghost w-full sm:w-auto" x-on:click="copyPlan()" x-text="copyPlanLabel()">@Tx("copy_plan")</button>
			<button type="button" class="btn-ghost w-full sm:w-auto" x-on:click="shareYear()">@Tx("share_year")</button>
			<a href="/crossing" class="btn-ghost w-full sm:w-auto">@Tx("crossing_learn")</a>
		</div>
		if withSupport {
			<div x-show="isIN()">
				@SupportUPICard()
			</div>
			<div x-show="isUS()" x-cloak>
				@SupportCardCard()
			</div>
			<p class="text-sm"><a href="/support" class="font-medium text-brand hover:underline">@Tx("support_open")</a></p>
		}
		<canvas id="fire-share-card" width="1200" height="630" class="hidden" aria-hidden="true"></canvas>
	</div>
}

templ SupportCardCard() {
	<div class="result-panel-support">
		<p class="result-kicker">@Tx("support_kicker")</p>
		<p class="mt-1 text-sm text-ink/60 dark:text-zinc-400">@Tx("support_lead_world")</p>
		<p class="mt-2 text-sm text-ink/60 dark:text-zinc-400">@Tx("support_card_note")</p>
		<div class="mt-3">
			<a href={ SupportCardHref() } class="btn-primary w-full sm:w-auto" target="_blank" rel="noopener noreferrer">@Tx("support_card")</a>
		</div>
	</div>
}

templ SupportUPICard() {
	<div class="result-panel-support" x-data="supportUPI()">
		<p class="result-kicker">@Tx("support_kicker")</p>
		<p class="mt-1 text-sm text-ink/60 dark:text-zinc-400">@Tx("support_lead")</p>
		<div class="support-upi-row">
			<div class="support-upi-qr">
				<img src={ SupportUPIQRSrc } width="488" height="488" alt="Google Pay UPI QR"/>
			</div>
			<div class="min-w-0 flex-1">
				<p class="support-upi-id">
					<a href={ SupportUPIHref() } data-support-upi={ SupportUPI() }>{ SupportUPI() }</a>
				</p>
				<p class="support-upi-note">Note: { SupportUPINote }</p>
				<p class="support-upi-desktop">@Tx("support_desktop")</p>
				<div class="mt-3 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
					<a href={ SupportUPIHref() } class="btn-primary w-full sm:hidden">@Tx("support_pay")</a>
					<button type="button" class="btn-ghost w-full sm:w-auto" x-on:click="copySupportUPI()" x-text="supportCopyLabel()">@Tx("support_copy")</button>
				</div>
				<p class="mt-2 text-sm">
					<a href={ SupportCardHref() } class="font-medium text-brand hover:underline" target="_blank" rel="noopener noreferrer">@Tx("support_via_card")</a>
				</p>
				<p class="mt-0.5 text-xs text-sky-950/65 dark:text-sky-100/65">@Tx("support_via_card_hint")</p>
			</div>
		</div>
	</div>
}

templ Support(p Page) {
	@Layout(p) {
		<article class="mx-auto max-w-3xl">
			<p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-brand sm:text-xs">@Tx("support_page_kicker")</p>
			<h1 class="mt-3 font-serif text-3xl tracking-tight sm:text-4xl">@Tx("support_page_h1")</h1>
			<p class="mt-4 max-w-2xl font-serif text-xl leading-snug text-ink/80 dark:text-zinc-200">@Tx("support_page_lede")</p>
			<div class="mt-10 space-y-8 rounded-3xl border border-brand/20 bg-white/80 p-5 shadow-card sm:p-8 dark:border-brand/30 dark:bg-white/5">
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("support_h_why")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("support_p_why")</p>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("support_p_why2")</p>
				</section>
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("support_h_how")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("support_p_how")</p>
					<div class="mt-6">
						@SupportUPICard()
					</div>
				</section>
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("support_h_world")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("support_p_world")</p>
					<div class="mt-6">
						@SupportCardCard()
					</div>
				</section>
				<p class="font-serif text-lg leading-snug text-ink/80 dark:text-zinc-200">@Tx("support_page_close")</p>
				<div class="flex flex-col gap-2 pt-2 sm:flex-row sm:flex-wrap">
					<a href="/calculators/fire" class="btn-primary w-full sm:w-auto">@Tx("jump_fire")</a>
					<a href="/" class="btn-ghost w-full sm:w-auto">@Tx("jump_home")</a>
				</div>
			</div>
		</article>
	}
}

templ Crossing(p Page) {
	@Layout(p) {
		@templ.Raw(JSONLDCrossingHTML())
		<article class="mx-auto max-w-3xl">
			<p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-brand sm:text-xs">@Tx("crossing_kicker")</p>
			<h1 class="mt-3 font-serif text-3xl tracking-tight sm:text-4xl">@Tx("crossing_h1")</h1>
			<p class="mt-4 max-w-2xl font-serif text-xl leading-snug text-ink/80 dark:text-zinc-200">@Tx("crossing_lede")</p>
			<div class="mt-10 space-y-8 rounded-3xl border border-brand/20 bg-white/80 p-5 shadow-card sm:p-8 dark:border-brand/30 dark:bg-white/5">
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("crossing_h_what")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("crossing_p_what")</p>
				</section>
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("crossing_h_measure")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("crossing_p_measure")</p>
				</section>
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("crossing_h_jew")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("crossing_p_jew")</p>
				</section>
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("crossing_h_not")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("crossing_p_not")</p>
				</section>
				<section>
					<h2 class="font-serif text-2xl tracking-tight">@Tx("crossing_h_use")</h2>
					<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("crossing_p_use")</p>
				</section>
				<div class="flex flex-col gap-2 pt-2 sm:flex-row sm:flex-wrap">
					<a href="/calculators/fire" class="btn-primary w-full sm:w-auto">@Tx("crossing_cta")</a>
					<a href="/about" class="btn-ghost w-full sm:w-auto">@Tx("jump_about")</a>
				</div>
			</div>
		</article>
	}
}

templ Disclaimer(p Page) {
	@Layout(p) {
		<article class="prose-disclaimer mx-auto max-w-2xl">
			<h1 class="font-serif text-3xl tracking-tight sm:text-4xl">@Tx("disc_h1")</h1>
			<p class="mt-6 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("disc_p1")</p>
			<h2 class="mt-10 font-serif text-2xl">@Tx("disc_h2")</h2>
			<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("disc_p2")</p>
			<h2 class="mt-10 font-serif text-2xl">@Tx("disc_h3")</h2>
			<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("disc_p3")</p>
			<h2 class="mt-10 font-serif text-2xl">@Tx("disc_h4")</h2>
			<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("disc_p4")</p>
			<h2 class="mt-10 font-serif text-2xl">@Tx("disc_h5")</h2>
			<p class="mt-3 leading-relaxed text-ink/80 dark:text-zinc-300">@Tx("disc_p5")</p>
			<p class="mt-8 text-sm text-ink/60 dark:text-zinc-400">Not registered investment advice. For educational purposes only.</p>
		</article>
	}
}

templ NotFound(p Page) {
	@Layout(p) {
		<article class="mx-auto max-w-xl text-center">
			<p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-brand sm:text-xs">@Tx("title_404")</p>
			<h1 class="mt-3 font-serif text-3xl tracking-tight sm:text-4xl">@Tx("not_found")</h1>
			<p class="mt-4 text-base leading-relaxed text-ink/70 dark:text-zinc-300">@Tx("not_found_body")</p>
			<a href="/" class="btn-primary mt-8 inline-flex">@Tx("not_found_home")</a>
		</article>
	}
}
